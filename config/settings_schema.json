[
  {
    "name": "theme_info",
    "theme_name": "Köderdepot",
    "theme_version": "1.0.0",
    "theme_author": "Südlicht Studio",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com"
  },
  {
    "name": "Logo & Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo",
        "info": "PNG mit transparentem Hintergrund oder SVG. Ohne Logo wird eine Wortmarke angezeigt."
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo-Breite (Desktop)",
        "min": 60,
        "max": 220,
        "step": 4,
        "unit": "px",
        "default": 132
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Quadratisch, mindestens 64 × 64 px."
      }
    ]
  },
  {
    "name": "Farben",
    "settings": [
      {
        "type": "paragraph",
        "content": "Standardwerte entsprechen dem Köderdepot-Logo. Gelb wird nur als Fläche mit schwarzem Text genutzt."
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Schwarz (Text, Flächen)",
        "default": "#0D0D0D"
      },
      {
        "type": "color",
        "id": "color_signal",
        "label": "Köder-Gelb (Buttons, Akzente)",
        "default": "#FFCC00"
      },
      {
        "type": "color",
        "id": "color_paper",
        "label": "Hintergrund",
        "default": "#F4F4F1"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Maximale Seitenbreite",
        "min": 1100,
        "max": 1800,
        "step": 20,
        "unit": "px",
        "default": 1440
      }
    ]
  },
  {
    "name": "Laden & Kontakt",
    "settings": [
      {
        "type": "paragraph",
        "content": "Diese Angaben erscheinen im Footer, im Abschnitt „Laden“ und bei der Abholung."
      },
      {
        "type": "text",
        "id": "store_name",
        "label": "Name",
        "default": "Köderdepot"
      },
      {
        "type": "textarea",
        "id": "store_address",
        "label": "Adresse",
        "default": "Schwaighofstraße 18 h\n86899 Landsberg am Lech"
      },
      {
        "type": "textarea",
        "id": "store_hours",
        "label": "Öffnungszeiten",
        "info": "Im bisherigen Shop nicht hinterlegt. Leer lassen blendet die Zeile aus."
      },
      {
        "type": "text",
        "id": "store_phone",
        "label": "Telefon",
        "default": "0176 41450088"
      },
      {
        "type": "text",
        "id": "store_email",
        "label": "E-Mail",
        "default": "info@koederdepot.de"
      },
      {
        "type": "url",
        "id": "store_map_url",
        "label": "Link zur Karte (Google Maps o. ä.)"
      }
    ]
  },
  {
    "name": "Warenkorb",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Nach „In den Warenkorb“",
        "options": [
          {
            "value": "drawer",
            "label": "Warenkorb seitlich öffnen"
          },
          {
            "value": "page",
            "label": "Zur Warenkorbseite wechseln"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Versandkostenfrei ab (€)",
        "info": "0 blendet die Fortschrittsanzeige aus.",
        "default": 100
      },
      {
        "type": "text",
        "id": "cart_note_pickup",
        "label": "Hinweis zur Abholung im Warenkorb",
        "default": "Abholung vor Ort in Landsberg am Lech ist kostenlos. Wähle an der Kasse „Abholung im Geschäft“."
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram",
        "default": "https://www.instagram.com/koederdepot/"
      },
      {
        "type": "url",
        "id": "social_facebook",
        "label": "Facebook"
      },
      {
        "type": "url",
        "id": "social_youtube",
        "label": "YouTube"
      },
      {
        "type": "url",
        "id": "social_tiktok",
        "label": "TikTok"
      }
    ]
  },
  {
    "name": "Produktkarten",
    "settings": [
      {
        "type": "checkbox",
        "id": "card_strip_vendor",
        "label": "Markennamen im Kartentitel weglassen",
        "info": "Aus „Köderdepot Rasselminnow“ wird „Rasselminnow“. Die Produktseite zeigt weiter den vollen Titel.",
        "default": true
      },
      {
        "type": "text",
        "id": "card_title_prefix",
        "label": "Markenname",
        "default": "Köderdepot"
      },
      {
        "type": "checkbox",
        "id": "card_show_meta",
        "label": "Köderart und Anzahl der Farben zeigen",
        "info": "Zum Beispiel „Wobbler · 10 Farben“ unter dem Titel.",
        "default": true
      }
    ]
  },
  {
    "name": "Köder-Box",
    "settings": [
      {
        "type": "paragraph",
        "content": "Zeigt im Warenkorb, wie viele Köder bis zur nächsten Rabattstufe fehlen. Die Rabatte selbst in Shopify unter Rabatte als automatische Rabatte mit denselben Stufen anlegen (Kollektion, Mindestmenge)."
      },
      {
        "type": "checkbox",
        "id": "box_enabled",
        "label": "Köder-Box anzeigen",
        "default": true
      },
      {
        "type": "collection",
        "id": "box_collection",
        "label": "Kollektion der Köder"
      },
      {
        "type": "number",
        "id": "box_t1_qty",
        "label": "Stufe 1: ab Anzahl",
        "default": 3
      },
      {
        "type": "number",
        "id": "box_t1_pct",
        "label": "Stufe 1: Rabatt in %",
        "default": 5
      },
      {
        "type": "number",
        "id": "box_t2_qty",
        "label": "Stufe 2: ab Anzahl",
        "default": 5
      },
      {
        "type": "number",
        "id": "box_t2_pct",
        "label": "Stufe 2: Rabatt in %",
        "default": 10
      },
      {
        "type": "number",
        "id": "box_t3_qty",
        "label": "Stufe 3: ab Anzahl",
        "default": 8
      },
      {
        "type": "number",
        "id": "box_t3_pct",
        "label": "Stufe 3: Rabatt in %",
        "default": 15
      }
    ]
  }
]
