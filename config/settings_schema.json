[
  {
    "name": "theme_info",
    "theme_name": "Köderdepot",
    "theme_version": "1.0.0",
    "theme_author": "Südlicht Studio",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com"
  },
  {
    "name": "Logo & Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo",
        "info": "PNG mit transparentem Hintergrund oder SVG. Ohne Logo wird eine Wortmarke angezeigt."
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo-Breite (Desktop)",
        "min": 60,
        "max": 220,
        "step": 4,
        "unit": "px",
        "default": 132
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Quadratisch, mindestens 64 × 64 px."
      }
    ]
  },
  {
    "name": "Farben",
    "settings": [
      {
        "type": "paragraph",
        "content": "Standardwerte entsprechen dem Köderdepot-Logo. Gelb wird nur als Fläche mit schwarzem Text genutzt."
      },
      { "type": "color", "id": "color_ink", "label": "Schwarz (Text, Flächen)", "default": "#0D0D0D" },
      { "type": "color", "id": "color_signal", "label": "Köder-Gelb (Buttons, Akzente)", "default": "#FFCC00" },
      { "type": "color", "id": "color_paper", "label": "Hintergrund", "default": "#F4F4F1" }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Maximale Seitenbreite",
        "min": 1100,
        "max": 1800,
        "step": 20,
        "unit": "px",
        "default": 1440
      }
    ]
  },
  {
    "name": "Laden & Kontakt",
    "settings": [
      {
        "type": "paragraph",
        "content": "Diese Angaben erscheinen im Footer, im Abschnitt „Laden“ und bei der Abholung."
      },
      { "type": "text", "id": "store_name", "label": "Name", "default": "Köderdepot" },
      { "type": "textarea", "id": "store_address", "label": "Adresse", "default": "Musterstraße 1\n86899 Landsberg am Lech" },
      { "type": "textarea", "id": "store_hours", "label": "Öffnungszeiten", "default": "Mo–Fr 9:00–18:00\nSa 9:00–14:00" },
      { "type": "text", "id": "store_phone", "label": "Telefon", "default": "+49 8191 000000" },
      { "type": "text", "id": "store_email", "label": "E-Mail", "default": "info@koederdepot.de" },
      { "type": "url", "id": "store_map_url", "label": "Link zur Karte (Google Maps o. ä.)" }
    ]
  },
  {
    "name": "Warenkorb",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Nach „In den Warenkorb“",
        "options": [
          { "value": "drawer", "label": "Warenkorb seitlich öffnen" },
          { "value": "page", "label": "Zur Warenkorbseite wechseln" }
        ],
        "default": "drawer"
      },
      {
        "type": "text",
        "id": "cart_note_pickup",
        "label": "Hinweis zur Abholung im Warenkorb",
        "default": "Abholung im Laden in Landsberg? Wähle an der Kasse „Abholung“."
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      { "type": "url", "id": "social_instagram", "label": "Instagram" },
      { "type": "url", "id": "social_facebook", "label": "Facebook" },
      { "type": "url", "id": "social_youtube", "label": "YouTube" },
      { "type": "url", "id": "social_tiktok", "label": "TikTok" }
    ]
  }
]
