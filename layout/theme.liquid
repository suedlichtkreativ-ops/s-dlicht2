<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#0D0D0D">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {{ 'archivo-var.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} – {{ 'general.tagged' | t: tags: current_tags.last }}{% endif -%}
      {%- if current_page != 1 %} – {{ 'general.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} | {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>

    {% render 'theme-styles' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}

    <div class="drawer drawer--right drawer--sheet" id="QuickAdd" data-drawer="quick-add" aria-hidden="true">
      <button type="button" class="drawer__backdrop" data-drawer-close tabindex="-1" aria-label="{{ 'general.close' | t }}"></button>
      <div class="drawer__panel" role="dialog" aria-modal="true" aria-labelledby="QuickAddHeading" tabindex="-1">
        <div class="drawer__head">
          <h2 class="drawer__title h3" id="QuickAddHeading">{{ 'products.product.choose_options' | t }}</h2>
          <button type="button" class="icon-btn" data-drawer-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
        </div>
        <div class="drawer__body" data-quick-add-body aria-live="polite"></div>
      </div>
    </div>

    {% section 'welcome-popup' %}

    <div class="toast" role="status" aria-live="polite" data-toast></div>

    <script>
      window.theme = {
        currency: {{ cart.currency.iso_code | default: shop.currency | json }},
        locale: {{ request.locale.iso_code | json }},
        routes: {
          root: {{ routes.root_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cart: {{ routes.cart_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }}
        },
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          added: {{ 'products.product.added' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          error: {{ 'general.error' | t | json }},
          cartError: {{ 'cart.error' | t | json }},
          removed: {{ 'cart.removed' | t | json }},
          undo: {{ 'cart.undo' | t | json }},
          suggestionOne: {{ 'search.status_one' | t | json }},
          suggestionOther: {{ 'search.status_other' | t | json }}
        },
        cartType: {{ settings.cart_type | json }}
      };
    </script>
  </body>
</html>
