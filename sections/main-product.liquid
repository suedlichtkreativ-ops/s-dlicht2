{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured = current_variant.featured_media | default: product.featured_media
  assign form_id = 'ProductForm-' | append: section.id
-%}
<div class="page-width" data-product-section data-section-id="{{ section.id }}" data-product-url="{{ product.url }}">
  <nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs' | t }}" style="padding-top:1.25rem">
    <ol role="list">
      <li><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a></li>
      {% render 'nav-trail', target: 'product', product: product, collection: collection, menu: section.settings.menu %}
      <li aria-current="page">{{ product.title | escape }}</li>
    </ol>
  </nav>

  <div class="product">
    <div class="gallery" data-gallery>
      <ul class="gallery__list" role="list" data-gallery-list aria-label="{{ 'products.product.gallery' | t }}">
        {%- if product.media.size > 0 -%}
          {%- if featured -%}
            <li class="gallery__item" data-media-id="{{ featured.id }}">
              <div class="media media--contain media--white" style="--ratio: 1 / 1">
                {% render 'image', image: featured.preview_image, sizes: '(min-width: 990px) 55vw, 100vw', loading: 'eager', fallback_alt: product.title %}
              </div>
            </li>
          {%- endif -%}
          {%- for media in product.media -%}
            {%- unless media.id == featured.id -%}
              <li class="gallery__item" data-media-id="{{ media.id }}">
                {%- case media.media_type -%}
                  {%- when 'video', 'external_video' -%}
                    <div class="media media--white" style="--ratio: {{ media.aspect_ratio | default: 1.7778 }}">
                      {{ media | media_tag: image_size: '1200x', autoplay: false, loop: false, controls: true }}
                    </div>
                  {%- else -%}
                    <div class="media media--contain media--white" style="--ratio: 1 / 1">
                      {% render 'image', image: media.preview_image, sizes: '(min-width: 990px) 27vw, 100vw', fallback_alt: product.title %}
                    </div>
                {%- endcase -%}
              </li>
            {%- endunless -%}
          {%- endfor -%}
        {%- else -%}
          <li class="gallery__item"><div class="media media--white">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div></li>
        {%- endif -%}
      </ul>
      {%- if product.media.size > 1 -%}
        <div class="gallery__dots" data-gallery-dots>
          {%- for media in product.media -%}
            <button type="button" aria-label="{{ 'products.product.show_media' | t: index: forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="product__info">
      {%- if product.vendor != blank and section.settings.show_vendor -%}
        <p class="card__vendor" style="font-size:.9375rem">{{ product.vendor | escape }}</p>
      {%- endif -%}
      <h1 class="product__title">{{ product.title | escape }}</h1>

      <div data-refresh="price">
        {% render 'price', product: product, target: current_variant, class: 'product__price' %}
        <p class="product__tax">
          {{ 'products.product.tax_included' | t }}
          {%- if shop.shipping_policy.body != blank %}, <a href="{{ shop.shipping_policy.url }}">{{ 'products.product.shipping' | t }}</a>{%- else %} {{ 'products.product.plus_shipping' | t }}{%- endif -%}
        </p>
      </div>

      {%- unless product.has_only_default_variant -%}
        <div class="stack" style="--stack:1.25rem" data-variant-picker data-refresh="picker">
          {%- for option in product.options_with_values -%}
            {%- liquid
              assign option_index = option.position | minus: 1
              assign option_name = option.name | downcase
              assign is_swatch = false
              if section.settings.image_swatches
                if option_name contains 'farbe' or option_name contains 'color' or option_name contains 'dekor'
                  assign is_swatch = true
                endif
              endif
            -%}
            <fieldset class="variant-picker{% if is_swatch %} variant-picker--swatch{% endif %}">
              <legend>{{ option.name | escape }}: <span class="muted" style="font-weight:500">{{ option.selected_value | escape }}</span>{% if is_swatch %} <span class="variant-picker__count muted">{{ 'products.product.colors_count' | t: count: option.values.size }}</span>{% endif %}</legend>
              <div class="variant-picker__values">
                {%- for value in option.values -%}
                  {%- assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index0 -%}
                  {%- liquid
                    assign swatch_media = nil
                    if is_swatch
                      for v in product.variants
                        if v.options[option_index] == value and v.featured_media
                          assign swatch_media = v.featured_media
                          break
                        endif
                      endfor
                    endif
                  -%}
                  <input type="radio" id="{{ input_id }}" name="option{{ option.position }}" value="{{ value | escape }}"
                    {% if option.selected_value == value %}checked{% endif %}
                    {% if value.available == false %}class="is-unavailable"{% endif %}>
                  <label for="{{ input_id }}"{% if swatch_media %} class="swatch"{% endif %}>
                    {%- if swatch_media -%}
                      <span class="swatch__img">{{ swatch_media.preview_image | image_url: width: 360, height: 240, crop: 'center' | image_tag: width: 120, height: 80, loading: 'lazy', alt: '' }}</span>
                      <span class="swatch__name">{{ value | escape }}</span>
                    {%- else -%}
                      {{ value | escape }}
                    {%- endif -%}
                    {%- if value.available == false %}<span class="visually-hidden"> – {{ 'products.product.unavailable' | t }}</span>{% endif -%}
                  </label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
        </div>
      {%- endunless -%}

      {%- form 'product', product, id: form_id, class: 'stack', data-product-form: '', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
        <div class="buy">
          <div class="qty" data-qty>
            <button type="button" data-qty-change="-1" aria-label="{{ 'products.product.decrease' | t }}">{% render 'icon', name: 'minus', class: 'icon--sm' %}</button>
            <input type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="{{ 'products.product.quantity' | t }}">
            <button type="button" data-qty-change="1" aria-label="{{ 'products.product.increase' | t }}">{% render 'icon', name: 'plus', class: 'icon--sm' %}</button>
          </div>
          <div data-refresh="buy">
            <button type="submit" name="add" class="btn btn--full" data-add-button{% unless current_variant.available %} disabled{% endunless %}>
              <span class="btn__label">
                {%- if current_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
              </span>
              <span class="spinner" aria-hidden="true"></span>
            </button>
          </div>
        </div>
        {%- if section.settings.show_dynamic_checkout -%}
          <div style="margin-top:.75rem">{{ form | payment_button }}</div>
        {%- endif -%}
        <div class="form-message form-message--error" role="alert" data-form-error hidden></div>
      {%- endform -%}

      <div class="stack" style="--stack:.75rem" data-refresh="availability">
        {%- if current_variant.available -%}
          <p class="stock">
            {%- if current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= 5 -%}
              {{ 'products.product.low_stock' | t: count: current_variant.inventory_quantity }}
            {%- else -%}
              {{ 'products.product.in_stock' | t }}
            {%- endif -%}
          </p>
        {%- else -%}
          <p class="stock stock--out">{{ 'products.product.sold_out' | t }}</p>
        {%- endif -%}

        {%- assign pickup_locations = current_variant.store_availabilities | where: 'pick_up_enabled', true -%}
        {%- if pickup_locations.size > 0 -%}
          {%- assign loc = pickup_locations.first -%}
          <div class="pickup">
            {% render 'icon', name: 'store' %}
            <div>
              {%- if loc.available -%}
                <strong>{{ 'products.product.pickup_available' | t: location: loc.location.name }}</strong>
                <span class="muted">{{ loc.pick_up_time }}</span>
              {%- else -%}
                <strong>{{ 'products.product.pickup_unavailable' | t: location: loc.location.name }}</strong>
              {%- endif -%}
            </div>
          </div>
        {%- elsif section.settings.pickup_note != blank -%}
          <div class="pickup">
            {% render 'icon', name: 'store' %}
            <div><strong>{{ section.settings.pickup_note | escape }}</strong>{%- if settings.store_address != blank -%}<span class="muted">{{ settings.store_address | newline_to_br | replace: '<br />', ', ' | strip_newlines }}</span>{%- endif -%}</div>
          </div>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
          {%- when 'text' -%}
            <div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'usps' -%}
            <ul class="product__usps" role="list" {{ block.shopify_attributes }}>
              {%- if block.settings.usp1 != blank -%}<li>{% render 'icon', name: 'truck', class: 'icon--sm' %}{{ block.settings.usp1 | escape }}</li>{%- endif -%}
              {%- if block.settings.usp2 != blank -%}<li>{% render 'icon', name: 'check', class: 'icon--sm' %}{{ block.settings.usp2 | escape }}</li>{%- endif -%}
              {%- if block.settings.usp3 != blank -%}<li>{% render 'icon', name: 'check', class: 'icon--sm' %}{{ block.settings.usp3 | escape }}</li>{%- endif -%}
            </ul>
          {%- when 'specs' -%}
            {%- liquid
              assign fish_list = ''
              for tag in product.tags
                if tag contains 'zielfisch-'
                  assign f = tag | remove: 'zielfisch-' | capitalize
                  assign fish_list = fish_list | append: f | append: ', '
                endif
              endfor
              assign fish_list = fish_list | remove_last: ', '
            -%}
            <dl class="specs" {{ block.shopify_attributes }}>
              {%- if product.type != blank -%}<div><dt>{{ 'products.product.specs_type' | t }}</dt><dd>{{ product.type | escape }}</dd></div>{%- endif -%}
              {%- if fish_list != blank -%}<div><dt>{{ 'products.product.specs_fish' | t }}</dt><dd>{{ fish_list }}</dd></div>{%- endif -%}
              {%- for option in product.options_with_values -%}
                {%- assign on = option.name | downcase -%}
                {%- if on contains 'farbe' or on contains 'color' -%}
                  <div><dt>{{ 'products.product.specs_colors' | t }}</dt><dd>{{ option.values.size }}</dd></div>
                {%- else -%}
                  <div><dt>{{ option.name | escape }}</dt><dd>{{ option.values | join: ' · ' }}</dd></div>
                {%- endif -%}
              {%- endfor -%}
              {%- if current_variant.sku != blank -%}<div><dt>{{ 'products.product.sku' | t }}</dt><dd data-refresh="sku">{{ current_variant.sku }}</dd></div>{%- endif -%}
            </dl>
          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="product__accordion" {{ block.shopify_attributes }}>
                <details{% if block.settings.open %} open{% endif %}>
                  <summary>{{ 'products.product.description' | t }}{% render 'icon', name: 'plus', class: 'icon--sm' %}</summary>
                  <div class="rte">{{ product.description }}</div>
                </details>
              </div>
            {%- endif -%}
          {%- when 'collapsible' -%}
            <div class="product__accordion" {{ block.shopify_attributes }}>
              <details>
                <summary>{{ block.settings.heading | escape }}{% render 'icon', name: 'plus', class: 'icon--sm' %}</summary>
                <div class="rte">
                  {{ block.settings.content }}
                  {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
                </div>
              </details>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="buy-bar" data-buy-bar aria-hidden="true">
    <div class="buy-bar__title">
      <span>{{ product.title | escape }}</span>
      <span class="price" data-refresh="bar-price">{{ current_variant.price | money }}</span>
    </div>
    <button type="button" class="btn" data-buy-bar-button tabindex="-1">{{ 'products.product.add_to_cart' | t }}</button>
  </div>

  <script type="application/json" data-variants>
    {{ product.variants | json }}
  </script>
</div>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "Produkt",
  "settings": [
    { "type": "checkbox", "id": "image_swatches", "label": "Farben als Bild zeigen", "info": "Für Optionen wie „Farbe“: zeigt das Variantenbild statt nur den Namen.", "default": true },
    { "type": "link_list", "id": "menu", "label": "Menü für die Navigation", "default": "main-menu", "info": "Aus diesem Menü kommt die Pfadangabe (die genaueste Kategorie, in der das Produkt steckt)." },
    { "type": "checkbox", "id": "show_vendor", "label": "Marke anzeigen", "default": false },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Express-Checkout-Buttons anzeigen", "info": "PayPal, Apple Pay usw., je nach Zahlungseinstellungen.", "default": false },
    { "type": "text", "id": "pickup_note", "label": "Hinweis Abholung", "info": "Wird gezeigt, solange in Shopify keine Abholung am Standort eingerichtet ist.", "default": "Abholung vor Ort in Landsberg kostenlos" }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "specs", "name": "Kurzdaten", "limit": 1, "settings": [{ "type": "paragraph", "content": "Zeigt Köderart (Produkttyp), Zielfische (Tags „zielfisch-…“), Optionen wie Größe und Gewicht, Anzahl der Farben und die Artikelnummer." }] },
    { "type": "description", "name": "Beschreibung", "limit": 1, "settings": [{ "type": "checkbox", "id": "open", "label": "Standardmäßig geöffnet", "default": true }] },
    {
      "type": "collapsible", "name": "Aufklappbereich",
      "settings": [
        { "type": "text", "id": "heading", "label": "Überschrift", "default": "Versand & Rückgabe" },
        { "type": "richtext", "id": "content", "label": "Inhalt" },
        { "type": "page", "id": "page", "label": "Inhalt aus Seite" }
      ]
    },
    { "type": "text", "name": "Text", "settings": [{ "type": "richtext", "id": "text", "label": "Text" }] },
    {
      "type": "usps", "name": "Vorteile", "limit": 1,
      "settings": [
        { "type": "text", "id": "usp1", "label": "Versand", "default": "Schnell geliefert mit DHL" },
        { "type": "text", "id": "usp2", "label": "Versandkosten", "default": "Versandkostenfrei ab 100 € in DE" },
        { "type": "text", "id": "usp3", "label": "Zahlung", "default": "Kauf auf Rechnung möglich" }
      ]
    }
  ]
}
{% endschema %}
