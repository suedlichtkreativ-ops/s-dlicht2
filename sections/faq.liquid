{%- comment -%}
  FAQ accordion. Emits FAQPage structured data so answers can appear in Google results.
{%- endcomment -%}
<section class="section faq{% if section.settings.white %} section--white{% endif %}" id="faq-{{ section.id }}">
  <div class="page-width faq__layout">
    <div class="faq__intro stack" style="--stack:1rem">
      {%- if section.settings.as_page_title -%}
        <h1 class="faq__heading display">{% render 'slant-words', text: section.settings.heading %}</h1>
      {%- else -%}
        <h2 class="faq__heading display">{% render 'slant-words', text: section.settings.heading %}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}<p class="muted">{{ section.settings.text | escape }}</p>{%- endif -%}
      {%- if section.settings.show_contact -%}
        <div class="faq__contact">
          <p class="h3">{{ 'faq.more_questions' | t }}</p>
          {%- if settings.store_phone != blank -%}<p><a class="text-link" href="tel:{{ settings.store_phone | remove: ' ' | remove: '/' }}">{{ settings.store_phone }}</a></p>{%- endif -%}
          {%- if settings.store_email != blank -%}<p><a class="text-link" href="mailto:{{ settings.store_email }}">{{ settings.store_email }}</a></p>{%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="faq__list">
      {%- for block in section.blocks -%}
        <details class="faq__item" {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary>
            <span>{{ block.settings.question | escape }}</span>
            <span class="faq__toggle" aria-hidden="true">{% render 'icon', name: 'plus' %}</span>
          </summary>
          <div class="faq__answer rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in section.blocks -%}
        {
          "@type": "Question",
          "name": {{ block.settings.question | json }},
          "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "max_blocks": 30,
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Häufige Fragen" },
    { "type": "text", "id": "text", "label": "Text", "default": "Zu unserem Shop und unseren Produkten." },
    { "type": "checkbox", "id": "as_page_title", "label": "Als Seitentitel (H1) ausgeben", "info": "Auf der FAQ-Seite aktivieren, auf der Startseite aus.", "default": false },
    { "type": "checkbox", "id": "open_first", "label": "Erste Frage geöffnet", "default": false },
    { "type": "checkbox", "id": "show_contact", "label": "Kontakt anzeigen", "default": true },
    { "type": "checkbox", "id": "white", "label": "Weißer Hintergrund", "default": false }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Frage",
      "settings": [
        { "type": "text", "id": "question", "label": "Frage", "default": "Wie lange dauert der Versand?" },
        { "type": "richtext", "id": "answer", "label": "Antwort", "default": "<p>Antwort hier eintragen.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ", "blocks": [{ "type": "question" }, { "type": "question" }, { "type": "question" }] }]
}
{% endschema %}
