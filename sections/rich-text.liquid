<section class="section{% if section.settings.style == 'ink' %} section--ink on-dark{% elsif section.settings.style == 'white' %} section--white{% endif %}">
  <div class="page-width stack" style="--stack:1.5rem">
    {%- if section.settings.heading != blank -%}
      <p class="statement">{{ section.settings.heading | escape }}</p>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="rte lead{% if section.settings.style == 'ink' %} muted{% endif %}">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="text-link" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Text",
  "settings": [
    { "type": "text", "id": "heading", "label": "Aussage", "default": "Wir verkaufen nur, womit wir selbst fischen würden." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Köderdepot ist ein Angelladen aus Landsberg am Lech. Hier steht, wie ihr arbeitet und wofür ihr steht – ersetzt diesen Text im Editor.</p>" },
    { "type": "text", "id": "button_label", "label": "Link-Text" },
    { "type": "url", "id": "button_link", "label": "Link" },
    {
      "type": "select", "id": "style", "label": "Hintergrund", "default": "paper",
      "options": [
        { "value": "paper", "label": "Hell" },
        { "value": "white", "label": "Weiß" },
        { "value": "ink", "label": "Schwarz" }
      ]
    }
  ],
  "presets": [{ "name": "Text" }]
}
{% endschema %}
