<div class="page-width" style="min-height:100dvh;display:grid;align-content:center;gap:2rem;padding-block:4rem">
  {%- if settings.logo != blank -%}
    {{ settings.logo | image_url: width: 480 | image_tag: widths: '240, 480', sizes: '240px', alt: shop.name, style: 'width:240px;height:auto' }}
  {%- endif -%}
  <h1 class="display" style="font-size:clamp(3.5rem,14vw,11rem)"><span class="slant">{{ section.settings.heading | escape }}</span></h1>
  {%- if shop.password_message != blank -%}<p class="lead" style="color:#d9d9d3">{{ shop.password_message }}</p>{%- endif -%}
  <details>
    <summary class="text-link" style="cursor:pointer;display:inline-block">{{ 'password.enter' | t }}</summary>
    {%- form 'storefront_password', class: 'search-form', style: 'margin-top:1rem' -%}
      {%- if form.errors -%}<p class="form-message form-message--error" role="alert">{{ 'password.error' | t }}</p>{%- endif -%}
      <label class="visually-hidden" for="Password">{{ 'password.label' | t }}</label>
      <input class="input" type="password" name="password" id="Password" autocomplete="current-password">
      <button type="submit" class="btn">{{ 'password.submit' | t }}</button>
    {%- endform -%}
  </details>
</div>
{% schema %}
{ "name": "Passwortseite", "settings": [{ "type": "text", "id": "heading", "label": "Überschrift", "default": "Bald geht's los." }] }
{% endschema %}
