<div class="page-width" style="padding-bottom:clamp(3rem,6vw,5rem)">
  <div class="page-head">
    <h1 class="page-head__title display">{% render 'slant-words', text: blog.title %}</h1>
  </div>
  {%- paginate blog.articles by 12 -%}
    <ul class="grid" role="list">
      {%- for article in blog.articles -%}
        <li>
          <a class="article-card" href="{{ article.url }}">
            <div class="media">
              {%- if article.image -%}{% render 'image', image: article.image, sizes: '(min-width: 750px) 30vw, 46vw', alt: '' %}{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
            </div>
            <span class="muted" style="font-size:.875rem">{{ article.published_at | time_tag: format: 'date' }}</span>
            <span class="article-card__title">{{ article.title | escape }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</div>
{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
