<div class="page-width" style="padding-bottom:clamp(3rem,6vw,5rem)">
  <div class="page-head">
    <h1 class="page-head__title page-title display"><span class="slant">{{ 'collections.all' | t }}</span></h1>
  </div>
  <ul class="tiles" role="list">
    {%- for collection in collections -%}
      <li>
        <a class="tile" href="{{ collection.url }}">
          <div class="media">
            {%- if collection.featured_image -%}
              {% render 'image', image: collection.featured_image, sizes: '(min-width: 990px) 24vw, 48vw', alt: '' %}
            {%- else -%}
              {%- assign ph = forloop.index | modulo: 4 | plus: 1 -%}
              {{ 'collection-' | append: ph | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <span class="tile__label">
            <span>
              <span class="tile__name display slant">{{ collection.title | escape }}</span>
              <span class="tile__count">{{ 'collections.count' | t: count: collection.products_count }}</span>
            </span>
            {% render 'icon', name: 'arrow' %}
          </span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</div>
{% schema %}
{ "name": "Alle Kategorien", "settings": [] }
{% endschema %}
