<section class="section{% if section.settings.white %} section--white{% endif %}">
  <div class="page-width split{% if section.settings.reverse %} split--reverse{% endif %}{% if section.settings.landscape %} split--landscape{% endif %}">
    <div class="media">
      {%- if section.settings.image != blank -%}
        {% render 'image', image: section.settings.image, sizes: '(min-width: 990px) 50vw, 100vw', alt: section.settings.image.alt %}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="split__content">
      <h2 class="section-title display">{% render 'slant-words', text: section.settings.heading %}</h2>
      {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="btn btn--slant" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bild mit Text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Bild" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Beratung, die am Wasser entsteht" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Erzählt hier, was euch ausmacht. Ein echtes Foto aus dem Laden oder vom Lech wirkt hier am besten.</p>" },
    { "type": "text", "id": "button_label", "label": "Button" },
    { "type": "url", "id": "button_link", "label": "Link" },
    { "type": "checkbox", "id": "reverse", "label": "Bild rechts", "default": false },
    { "type": "checkbox", "id": "landscape", "label": "Querformat-Bild", "default": false },
    { "type": "checkbox", "id": "white", "label": "Weißer Hintergrund", "default": false }
  ],
  "presets": [{ "name": "Bild mit Text" }]
}
{% endschema %}
