{%- comment -%}
  Bundle detail: what's inside, single-item total vs. bundle price, who it's for.
  Used on the product.bundle template below the main product section.
{%- endcomment -%}
{%- liquid
  assign items_total = 0
  for block in section.blocks
    if block.settings.product != blank
      assign item_price = block.settings.product.price
      if block.settings.variant != blank
        for v in block.settings.product.variants
          if v.title contains block.settings.variant
            assign item_price = v.price
            break
          endif
        endfor
      endif
      assign line = item_price | times: block.settings.quantity
      assign items_total = items_total | plus: line
    endif
  endfor
  assign bundle_price = product.selected_or_first_available_variant.price
  assign saving = items_total | minus: bundle_price
-%}
{%- if section.blocks.size > 0 -%}
<section class="section section--white bundle">
  <div class="page-width bundle__layout">
    <div class="stack" style="--stack:1.25rem">
      <h2 class="bundle__heading section-title display">{% render 'slant-words', text: section.settings.heading %}</h2>
      {%- if section.settings.audience != blank -%}
        <div class="bundle__audience">
          <p class="h3">{{ section.settings.audience_heading | escape }}</p>
          <div class="rte">{{ section.settings.audience }}</div>
        </div>
      {%- endif -%}
      {%- if saving > 0 -%}
        <div class="bundle__saving">
          <span class="bundle__saving-label">{{ 'bundle.saving' | t }}</span>
          <span class="bundle__saving-value">{{ saving | money_without_currency | append: ' €' }}</span>
          {%- assign items_total_money = items_total | money_without_currency | append: ' €' -%}
          <span class="muted">{{ 'bundle.compared' | t: total: items_total_money }}</span>
        </div>
      {%- endif -%}
    </div>

    <ol class="bundle__items" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign p = block.settings.product
          assign item_price = p.price
          if p != blank and block.settings.variant != blank
            for v in p.variants
              if v.title contains block.settings.variant
                assign item_price = v.price
                break
              endif
            endfor
          endif
        -%}
        <li class="bundle__item" {{ block.shopify_attributes }}>
          <span class="bundle__qty">{{ block.settings.quantity }}×</span>
          <span class="media media--white">
            {%- if p.featured_media -%}
              {% render 'image', image: p.featured_media.preview_image, sizes: '96px', widths: '96, 192', alt: '' %}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </span>
          <span class="bundle__info">
            {%- if p != blank -%}
              {%- liquid
                assign item_title = p.title
                if settings.card_strip_vendor and settings.card_title_prefix != blank
                  assign vendor_prefix = settings.card_title_prefix | strip | append: ' '
                  assign title_start = p.title | slice: 0, vendor_prefix.size
                  if title_start == vendor_prefix
                    assign item_title = p.title | remove_first: vendor_prefix
                  endif
                endif
              -%}
              <a class="bundle__title" href="{{ p.url }}">{{ item_title | escape }}</a>
            {%- else -%}
              <span class="bundle__title">{{ block.settings.fallback_title | default: 'Produkt wählen' | escape }}</span>
            {%- endif -%}
            {%- if block.settings.note != blank -%}<span class="muted">{{ block.settings.note | escape }}</span>{%- endif -%}
          </span>
          {%- if p != blank -%}<span class="price">{{ item_price | times: block.settings.quantity | money_without_currency | append: ' €' }}</span>{%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Bundle-Inhalt",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Das steckt drin" },
    { "type": "text", "id": "audience_heading", "label": "Überschrift Zielgruppe", "default": "Für wen?" },
    { "type": "richtext", "id": "audience", "label": "Für wen ist das Bundle?", "info": "Wer soll das Bundle kaufen? Leer lassen blendet den Absatz aus." }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Bestandteil",
      "settings": [
        { "type": "product", "id": "product", "label": "Produkt" },
        { "type": "number", "id": "quantity", "label": "Anzahl", "default": 1 },
        { "type": "text", "id": "variant", "label": "Variante", "info": "Teil des Variantennamens, z. B. „10 g“ oder „0,148 mm“. Bestimmt den Einzelpreis." },
        { "type": "text", "id": "note", "label": "Hinweis", "info": "z. B. „10–40 g Wurfgewicht“" },
        { "type": "text", "id": "fallback_title", "label": "Name, solange kein Produkt gewählt ist" }
      ]
    }
  ],
  "presets": [{ "name": "Bundle-Inhalt" }]
}
{% endschema %}
