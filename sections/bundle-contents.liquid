{%- comment -%}
  Bundle detail: what's inside, single-item total vs. bundle price, who it's for.
  Used on the product.bundle template below the main product section.
{%- endcomment -%}
{%- liquid
  assign items_total = 0
  for block in section.blocks
    if block.settings.product != blank
      assign line = block.settings.product.price | times: block.settings.quantity
      assign items_total = items_total | plus: line
    endif
  endfor
  assign bundle_price = product.selected_or_first_available_variant.price
  assign saving = items_total | minus: bundle_price
-%}
<section class="section section--white bundle">
  <div class="page-width bundle__layout">
    <div class="stack" style="--stack:1.25rem">
      <h2 class="bundle__heading section-title display">{% render 'slant-words', text: section.settings.heading %}</h2>
      {%- if section.settings.audience != blank -%}
        <div class="bundle__audience">
          <p class="h3">{{ section.settings.audience_heading | escape }}</p>
          <div class="rte">{{ section.settings.audience }}</div>
        </div>
      {%- endif -%}
      {%- if saving > 0 -%}
        <div class="bundle__saving">
          <span class="bundle__saving-label">{{ 'bundle.saving' | t }}</span>
          <span class="bundle__saving-value">{{ saving | money }}</span>
          {%- assign items_total_money = items_total | money -%}
          <span class="muted">{{ 'bundle.compared' | t: total: items_total_money }}</span>
        </div>
      {%- endif -%}
    </div>

    <ol class="bundle__items" role="list">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        <li class="bundle__item" {{ block.shopify_attributes }}>
          <span class="bundle__qty">{{ block.settings.quantity }}×</span>
          <span class="media media--white">
            {%- if p.featured_image -%}
              {% render 'image', image: p.featured_image, sizes: '96px', widths: '96, 192', alt: '' %}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </span>
          <span class="bundle__info">
            {%- if p != blank -%}
              <a class="bundle__title" href="{{ p.url }}">{{ p.title | escape }}</a>
            {%- else -%}
              <span class="bundle__title">{{ block.settings.fallback_title | default: 'Produkt wählen' | escape }}</span>
            {%- endif -%}
            {%- if block.settings.note != blank -%}<span class="muted">{{ block.settings.note | escape }}</span>{%- endif -%}
          </span>
          {%- if p != blank -%}<span class="price">{{ p.price | times: block.settings.quantity | money }}</span>{%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Bundle-Inhalt",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Das steckt drin" },
    { "type": "text", "id": "audience_heading", "label": "Überschrift Zielgruppe", "default": "Für wen?" },
    { "type": "richtext", "id": "audience", "label": "Für wen ist das Bundle?", "default": "<p>Für alle, die mit dem Spinnfischen anfangen und nicht erst zehn Einzelteile vergleichen wollen.</p>" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Bestandteil",
      "settings": [
        { "type": "product", "id": "product", "label": "Produkt" },
        { "type": "number", "id": "quantity", "label": "Anzahl", "default": 1 },
        { "type": "text", "id": "note", "label": "Hinweis", "info": "z. B. „10–40 g Wurfgewicht“" },
        { "type": "text", "id": "fallback_title", "label": "Name, solange kein Produkt gewählt ist" }
      ]
    }
  ],
  "presets": [{ "name": "Bundle-Inhalt" }]
}
{% endschema %}
