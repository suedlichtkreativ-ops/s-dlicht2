{%- comment -%}
  Köder-Finder: three quick questions (target fish, water zone, way of fishing) that rank the lures of one
  collection by their product tags, plus a "Glücksgriff" that draws a random matching lure.
  The cards come from /collections/<handle>?view=finder-cards (real product cards incl. quick add), loaded once
  when the first result is shown; theme.js only ranks, orders and explains them. Matching uses tags only.
{%- endcomment -%}
{%- liquid
  assign source = section.settings.collection
  assign fishes = 'hecht,zander,barsch,forelle' | split: ','
-%}
<section class="finder" id="finder" data-finder data-max="{{ section.settings.max }}" aria-labelledby="FinderTitle-{{ section.id }}"
  data-t-exact="{{ 'finder.exact' | t }}" data-t-exact-one="{{ 'finder.exact_one' | t }}" data-t-close="{{ 'finder.close' | t }}"
  data-t-why="{{ 'finder.why' | t }}" data-t-lucky="{{ 'finder.lucky_result' | t }}">
  <div class="page-width">
    <div class="finder__head">
      <h2 class="finder__title display" id="FinderTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="finder__text">{{ section.settings.text | escape }}</p>{%- endif -%}
      {%- if section.settings.advice_link != blank -%}<a class="text-link finder__advice" href="{{ section.settings.advice_link }}">{{ 'finder.advice_link' | t }}</a>{%- endif -%}
    </div>

    {%- if source != blank and source.products_count > 0 -%}
      <form class="finder__form" data-finder-form novalidate>
        <fieldset class="finder__step is-active" data-step="fish">
          <legend class="finder__q"><span class="finder__num">1 / 3</span> {{ 'finder.q_fish' | t }}</legend>
          <div class="finder__options finder__options--fish">
            {%- for fish in fishes -%}
              {%- assign fish_label = fish | capitalize -%}
              <label class="finder__option finder__option--fish">
                <input type="radio" name="fish" value="{{ fish }}" data-label="{{ fish_label }}"
                  data-tags="{{ fish }}köder|zielfisch-{{ fish }}" data-url="{{ routes.collections_url }}/{{ fish }}koder">
                <span class="finder__disc" aria-hidden="true">{% render 'fish-icon', name: fish %}</span>
                <span class="finder__label">{{ fish_label }}</span>
              </label>
            {%- endfor -%}
          </div>
        </fieldset>

        <fieldset class="finder__step" data-step="zone" hidden>
          <legend class="finder__q"><span class="finder__num">2 / 3</span> {{ 'finder.q_zone' | t }}</legend>
          <div class="finder__options">
            <label class="finder__option"><input type="radio" name="zone" value="oben" data-label="{{ 'finder.zone_top' | t }}" data-tags="topwater|oberflächenköder|popper|froschköder"><span class="finder__label">{{ 'finder.zone_top' | t }}</span><span class="finder__hint">{{ 'finder.zone_top_hint' | t }}</span></label>
            <label class="finder__option"><input type="radio" name="zone" value="flach" data-label="{{ 'finder.zone_shallow' | t }}" data-tags="flachwasser|krautkante|seerosen|floating"><span class="finder__label">{{ 'finder.zone_shallow' | t }}</span><span class="finder__hint">{{ 'finder.zone_shallow_hint' | t }}</span></label>
            <label class="finder__option"><input type="radio" name="zone" value="grund" data-label="{{ 'finder.zone_deep' | t }}" data-tags="jiggen|jigkopf|texas rig|carolina rig|sinking|creature bait"><span class="finder__label">{{ 'finder.zone_deep' | t }}</span><span class="finder__hint">{{ 'finder.zone_deep_hint' | t }}</span></label>
            <label class="finder__option"><input type="radio" name="zone" value="" data-label="" data-tags=""><span class="finder__label">{{ 'finder.any' | t }}</span></label>
          </div>
        </fieldset>

        <fieldset class="finder__step" data-step="style" hidden>
          <legend class="finder__q"><span class="finder__num">3 / 3</span> {{ 'finder.q_style' | t }}</legend>
          <div class="finder__options">
            <label class="finder__option"><input type="radio" name="style" value="kurbeln" data-label="{{ 'finder.style_reel' | t }}" data-tags="spinnfischen|suchköder|spinnerbait|crankbait|spinnköder"><span class="finder__label">{{ 'finder.style_reel' | t }}</span><span class="finder__hint">{{ 'finder.style_reel_hint' | t }}</span></label>
            <label class="finder__option"><input type="radio" name="style" value="zupfen" data-label="{{ 'finder.style_jig' | t }}" data-tags="jiggen|stop and go|jerkbait|finesse"><span class="finder__label">{{ 'finder.style_jig' | t }}</span><span class="finder__hint">{{ 'finder.style_jig_hint' | t }}</span></label>
            <label class="finder__option"><input type="radio" name="style" value="laut" data-label="{{ 'finder.style_loud' | t }}" data-tags="rassel|rasselköder|reizköder|vibrationsköder|topwater"><span class="finder__label">{{ 'finder.style_loud' | t }}</span><span class="finder__hint">{{ 'finder.style_loud_hint' | t }}</span></label>
            <label class="finder__option"><input type="radio" name="style" value="" data-label="" data-tags=""><span class="finder__label">{{ 'finder.any' | t }}</span></label>
          </div>
        </fieldset>

        <div class="finder__nav">
          <button type="button" class="finder__back" data-finder-back hidden>{% render 'icon', name: 'chevron-left', class: 'icon--sm' %}{{ 'finder.back' | t }}</button>
        </div>
      </form>

      <div class="finder__result" data-finder-result hidden>
        <div class="finder__result-head">
          <p class="finder__summary" data-finder-summary role="status" tabindex="-1"></p>
          <div class="finder__actions">
            <button type="button" class="btn btn--slant" data-finder-lucky>{{ 'finder.lucky' | t }}</button>
            <button type="button" class="finder__restart" data-finder-restart>{{ 'finder.restart' | t }}</button>
          </div>
        </div>

        <div class="finder__stage" data-finder-stage hidden>
          <div class="finder__slot" aria-hidden="true"><img data-finder-slot src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" width="400" height="400"></div>
          <div class="finder__winner" data-finder-winner></div>
        </div>

        <ul class="grid grid--4 finder__grid" role="list" data-finder-grid data-src="{{ source.url }}?view=finder-cards"></ul>

        <a class="btn btn--outline finder__more" href="{{ source.url }}" data-finder-more>{{ 'finder.more' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Köder-Finder",
  "tag": "div",
  "class": "finder-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Welcher Köder passt zu dir?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Drei kurze Fragen, dann zeigen wir dir die passenden Köder aus unserem Sortiment. Oder du lässt dich mit dem Glücksgriff überraschen." },
    { "type": "collection", "id": "collection", "label": "Köder aus Kollektion", "info": "Empfohlen: „Köder“. Die Zuordnung läuft über die Produkt-Tags (z. B. Hechtköder, Topwater, Jiggen, Rassel)." },
    { "type": "url", "id": "advice_link", "label": "Link zur Köderberatung", "info": "Auf der Startseite: Seite „Köderberatung“. Auf der Köderberatung selbst leer lassen." },
    { "type": "range", "id": "max", "label": "Vorschläge", "min": 3, "max": 12, "step": 1, "default": 6 }
  ],
  "presets": [{ "name": "Köder-Finder" }]
}
{% endschema %}
