{%- comment -%}
  Fangbericht: the gear used for this catch as product cards (article metafield custom.ausruestung).
  If the gear isn't known any more, custom.empfehlung shows matching gear instead, clearly labelled as a suggestion.
{%- endcomment -%}
{%- liquid
  assign gear = article.metafields.custom.ausruestung.value
  assign heading = section.settings.heading
  assign text = section.settings.text
  if gear == blank
    assign gear = article.metafields.custom.empfehlung.value
    assign heading = section.settings.heading_suggest
    assign text = section.settings.text_suggest
  endif
-%}
{%- if gear != blank -%}
  <section class="section catch-gear" id="ausruestung">
    <div class="page-width">
      <h2 class="section-title display">{% render 'slant-words', text: heading %}</h2>
      {%- if text != blank -%}<p class="muted advice__intro">{{ text | escape }}</p>{%- endif -%}
      {%- liquid
        comment
          Balanced rows: 5 products in one row of five, 6 in two rows of three, otherwise rows of four.
        endcomment
        case gear.size
          when 5
            assign gear_cols = 'grid--5'
          when 6, 3
            assign gear_cols = 'grid--3'
          else
            assign gear_cols = 'grid--4'
        endcase
      -%}
      <ul class="grid {{ gear_cols }} catch-gear__grid" role="list">
        {%- for product in gear -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      </ul>
      {%- if section.settings.show_blog_link -%}<p class="catch-gear__back"><a class="text-link" href="{{ blog.url }}">{{ 'catches.all' | t }}</a></p>{%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Fangbericht: Ausrüstung",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Damit gefangen" },
    { "type": "text", "id": "text", "label": "Text", "default": "Genau diese Ausrüstung war im Einsatz. Alles bei uns im Shop." },
    { "type": "text", "id": "heading_suggest", "label": "Überschrift, wenn die Ausrüstung nicht bekannt ist", "default": "Passende Ausrüstung" },
    { "type": "text", "id": "text_suggest", "label": "Text dazu", "default": "Womit genau gefangen wurde, wissen wir nicht mehr. So würden wir es heute angehen." },
    { "type": "checkbox", "id": "show_blog_link", "label": "Link zu allen Fängen", "default": true }
  ]
}
{% endschema %}
