{%- comment -%} Fangbericht: the gear used for this catch as product cards (article metafield custom.ausruestung). {%- endcomment -%}
{%- assign gear = article.metafields.custom.ausruestung.value -%}
{%- if gear != blank -%}
  <section class="section catch-gear" id="ausruestung">
    <div class="page-width">
      <h2 class="section-title display">{% render 'slant-words', text: section.settings.heading %}</h2>
      {%- if section.settings.text != blank -%}<p class="muted advice__intro">{{ section.settings.text | escape }}</p>{%- endif -%}
      <ul class="grid grid--4 catch-gear__grid" role="list">
        {%- for product in gear -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      </ul>
      {%- if section.settings.show_blog_link -%}<p class="catch-gear__back"><a class="text-link" href="{{ blog.url }}">{{ 'catches.all' | t }}</a></p>{%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Fangbericht: Ausrüstung",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Damit gefangen" },
    { "type": "text", "id": "text", "label": "Text", "default": "Genau diese Ausrüstung war im Einsatz. Alles bei uns im Shop." },
    { "type": "checkbox", "id": "show_blog_link", "label": "Link zu allen Fängen", "default": true }
  ]
}
{% endschema %}
