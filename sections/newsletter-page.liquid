{%- comment -%}
  Newsletter page: sign-up (Shopify customer form, tag "newsletter"), what's in it, and the 10 % welcome offer via account.
  Double opt-in is switched on in Shopify (Einstellungen → Kundenbenachrichtigungen / Marketing).
{%- endcomment -%}
<section class="info-page newsletter-page">
  <div class="page-width newsletter-page__grid">
    <div>
      <p class="info-page__eyebrow">{{ 'newsletter.eyebrow' | t }}</p>
      <h1 class="page-title display">{% render 'slant-words', text: section.settings.heading %}</h1>
      {%- if section.settings.text != blank -%}<p class="lead newsletter-page__lead">{{ section.settings.text | escape }}</p>{%- endif -%}
      <ul class="auth__perks newsletter-page__perks" role="list">
        {%- for i in (1..3) -%}
          {%- assign key = 'perk_' | append: i -%}
          {%- if section.settings[key] != blank -%}<li>{% render 'icon', name: 'check' %}<span>{{ section.settings[key] | escape }}</span></li>{%- endif -%}
        {%- endfor -%}
      </ul>
    </div>

    <div class="newsletter-page__box">
      {%- form 'customer', class: 'form-grid', id: 'NewsletterPageForm' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,newsletter-seite">
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success" role="status">{{ section.settings.success | escape }}</p>
        {%- else -%}
          {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
          <div class="field">
            <label for="NewsletterPageEmail">{{ 'customer.email' | t }}</label>
            <input class="input" type="email" id="NewsletterPageEmail" name="contact[email]" autocomplete="email" required>
          </div>
          <button class="btn btn--full" type="submit">{{ section.settings.button | escape }}</button>
          <p class="auth__legal">{{ section.settings.consent | escape }}{%- if shop.privacy_policy %} <a class="text-link" href="{{ shop.privacy_policy.url }}">{{ 'welcome.privacy' | t }}</a>{%- endif -%}.</p>
        {%- endif -%}
      {%- endform -%}
      {%- unless customer -%}
        <p class="auth__offer newsletter-page__offer">{% render 'icon', name: 'tag', class: 'icon--sm' %}<span>{{ 'newsletter.offer' | t }} <a class="text-link" href="{{ routes.account_register_url }}?willkommen">{{ 'customer.register.title' | t }}</a></span></p>
      {%- endunless -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Neues aus dem Köderdepot" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Etwa einmal im Monat: neue Köder, frische Fangberichte und Aktionen. Kein Spam, Abmeldung jederzeit mit einem Klick." },
    { "type": "text", "id": "perk_1", "label": "Punkt 1", "default": "Neue Köder zuerst sehen" },
    { "type": "text", "id": "perk_2", "label": "Punkt 2", "default": "Fangberichte und Tipps aus der Praxis" },
    { "type": "text", "id": "perk_3", "label": "Punkt 3", "default": "Aktionen nur für Abonnenten" },
    { "type": "text", "id": "button", "label": "Button", "default": "Newsletter abonnieren" },
    { "type": "textarea", "id": "consent", "label": "Hinweis unter dem Feld", "default": "Du bekommst eine E-Mail zur Bestätigung. Abmeldung jederzeit über den Link in jedem Newsletter. Mehr in unserer" },
    { "type": "textarea", "id": "success", "label": "Text nach der Anmeldung", "default": "Fast geschafft: Bitte bestätige deine Anmeldung über den Link in der E-Mail, die wir dir gerade geschickt haben." }
  ]
}
{% endschema %}
