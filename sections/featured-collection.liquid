{%- assign c = section.settings.collection -%}
<section class="section{% if section.settings.white %} section--white{% endif %}">
  <div class="page-width">
    <div class="section-head">
      <h2 class="section-title display">{% render 'slant-words', text: section.settings.heading %}</h2>
      {%- if c != blank -%}
        <a class="text-link" href="{{ c.url }}">{{ 'collections.view_all' | t }}</a>
      {%- endif -%}
    </div>
    <ul class="grid {% if section.settings.limit == 5 %}grid--5{% else %}grid--4{% endif %}" role="list">
      {%- if c != blank and c.products_count > 0 -%}
        {%- for product in c.products limit: section.settings.limit -%}
          <li>{% render 'product-card', product: product, show_vendor: section.settings.show_vendor %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.limit) -%}
          <li>{% render 'product-card', product: blank, index: i %}</li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Produktauswahl",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Neu im Depot" },
    { "type": "collection", "id": "collection", "label": "Kollektion" },
    { "type": "range", "id": "limit", "label": "Anzahl Produkte", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "show_vendor", "label": "Marke anzeigen", "default": false },
    { "type": "checkbox", "id": "white", "label": "Weißer Hintergrund", "default": false }
  ],
  "presets": [{ "name": "Produktauswahl" }]
}
{% endschema %}
