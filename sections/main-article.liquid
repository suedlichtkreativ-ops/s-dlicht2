<article class="page-width" style="padding-bottom:clamp(3rem,6vw,5rem)">
  <div class="page-head stack" style="--stack:1rem">
    <p class="muted">{{ article.published_at | time_tag: format: 'date' }}{% if article.author %} – {{ article.author }}{% endif %}</p>
    <h1 class="h1" style="max-width:20ch">{{ article.title | escape }}</h1>
  </div>
  {%- if article.image -%}
    <div class="media article__image" style="--ratio:16/9;border:var(--border);margin-bottom:2.5rem">
      {% render 'image', image: article.image, sizes: '(min-width: 1100px) 1040px, 100vw', loading: 'eager', alt: article.image.alt %}
    </div>
  {%- endif -%}
  <div class="rte lead">{{ article.content | replace: '<h1', '<h2' | replace: '</h1>', '</h2>' }}</div>
  <p style="margin-top:3rem"><a class="text-link" href="{{ blog.url }}">{{ 'blog.back' | t: title: blog.title }}</a></p>
</article>
{% schema %}
{ "name": "Beitrag", "settings": [] }
{% endschema %}
