{%- comment -%}
  Sign-up and login in one place (templates customers/register and customers/login, classic customer accounts).
  Left: what an account brings, incl. the welcome discount. Right: tabs "Konto anlegen" / "Anmelden".
  After a successful sign-up Shopify follows return_to: /discount/<code>?redirect=/cart puts the welcome code
  into the cart. On the login tab this only happens when the visitor came from the offer (?willkommen), see theme.js.
{%- endcomment -%}
{%- liquid
  assign is_register = true
  if template.name == 'login'
    assign is_register = false
  endif
  assign code = section.settings.code | strip
  assign welcome_return = ''
  if code != blank
    assign welcome_return = '/discount/' | append: code | append: '?redirect=' | append: routes.cart_url
  endif
-%}
<section class="auth" data-auth data-welcome-return="{{ welcome_return }}">
  <div class="page-width auth__grid">
    <aside class="auth__aside on-dark{% if section.settings.image != blank %} auth__aside--image{% endif %}">
      {%- if section.settings.image != blank -%}
        <div class="auth__bg" aria-hidden="true">{{ section.settings.image | image_url: width: 900 | image_tag: widths: '450, 675, 900', sizes: '(min-width: 990px) 30rem, 100vw', alt: '', loading: 'lazy' }}</div>
      {%- endif -%}
      <h2 class="auth__title display">{% render 'slant-words', text: section.settings.heading %}</h2>
      {%- if section.settings.text != blank -%}<p class="auth__lead">{{ section.settings.text | escape }}</p>{%- endif -%}
      <ul class="auth__perks" role="list">
        {%- if code != blank -%}
          <li>{% render 'icon', name: 'tag' %}<span><strong>{{ section.settings.perk_discount | escape }}</strong> {{ 'customer.auth.perk_discount_note' | t }}</span></li>
        {%- endif -%}
        <li>{% render 'icon', name: 'package' %}<span>{{ 'customer.auth.perk_orders' | t }}</span></li>
        <li>{% render 'icon', name: 'store' %}<span>{{ 'customer.auth.perk_checkout' | t }}</span></li>
        <li>{% render 'icon', name: 'mail' %}<span>{{ 'customer.auth.perk_news' | t }}</span></li>
      </ul>
    </aside>

    <div class="auth__panel">
      <nav class="auth__tabs" aria-label="{{ 'customer.account.title' | t }}">
        <a href="{{ routes.account_register_url }}" class="auth__tab{% if is_register %} is-active{% endif %}" data-auth-tab{% if is_register %} aria-current="page"{% endif %}>{{ 'customer.register.title' | t }}</a>
        <a href="{{ routes.account_login_url }}" class="auth__tab{% unless is_register %} is-active{% endunless %}" data-auth-tab{% unless is_register %} aria-current="page"{% endunless %}>{{ 'customer.login.title' | t }}</a>
      </nav>

      {%- if is_register -%}
        <h1 class="auth__heading h3">{{ 'customer.register.title' | t }}</h1>
        {%- if code != blank -%}
          <p class="auth__offer">{% render 'icon', name: 'tag', class: 'icon--sm' %}<span>{{ 'customer.auth.offer' | t }}</span></p>
        {%- endif -%}
        {%- form 'create_customer', class: 'form-grid auth__form' -%}
          {%- if welcome_return != blank -%}<input type="hidden" name="return_to" value="{{ welcome_return }}">{%- endif -%}
          {%- if form.errors -%}<div class="form-message form-message--error" role="alert" tabindex="-1" data-auth-errors>{{ form.errors | default_errors }}</div>{%- endif -%}
          <div class="form-grid form-grid--2">
            <div class="field"><label for="RegFirst">{{ 'customer.first_name' | t }} <span class="auth__req" aria-hidden="true">*</span></label><input class="input" id="RegFirst" name="customer[first_name]" value="{{ form.first_name }}" autocomplete="given-name" required></div>
            <div class="field"><label for="RegLast">{{ 'customer.last_name' | t }} <span class="auth__req" aria-hidden="true">*</span></label><input class="input" id="RegLast" name="customer[last_name]" value="{{ form.last_name }}" autocomplete="family-name" required></div>
          </div>
          <div class="field"><label for="RegEmail">{{ 'customer.email' | t }} <span class="auth__req" aria-hidden="true">*</span></label><input class="input" type="email" id="RegEmail" name="customer[email]" value="{{ form.email }}" autocomplete="email" autocapitalize="off" spellcheck="false" required></div>
          <div class="field">
            <label for="RegPassword">{{ 'customer.password' | t }} <span class="auth__req" aria-hidden="true">*</span></label>
            <div class="auth__pw">
              <input class="input" type="password" id="RegPassword" name="customer[password]" autocomplete="new-password" minlength="8" aria-describedby="RegPasswordHint" required>
              <button type="button" class="auth__eye" data-pw-toggle aria-controls="RegPassword" aria-pressed="false" aria-label="{{ 'customer.auth.show_password' | t }}">{% render 'icon', name: 'eye' %}</button>
            </div>
            <p class="auth__hint" id="RegPasswordHint">{{ 'customer.auth.password_hint' | t }}</p>
          </div>
          <label class="auth__check">
            <input type="checkbox" name="customer[accepts_marketing]" value="true"{% if section.settings.newsletter_checked %} checked{% endif %}>
            <span><strong>{{ 'customer.auth.newsletter' | t }}</strong> {{ section.settings.newsletter_text | escape }}</span>
          </label>
          <p class="auth__legal">
            {{ 'customer.auth.legal' | t }}
            {%- if shop.privacy_policy %} <a class="text-link" href="{{ shop.privacy_policy.url }}">{{ 'welcome.privacy' | t }}</a>{%- endif -%}.
          </p>
          <button class="btn btn--full" type="submit">{{ 'customer.register.submit' | t }}</button>
        {%- endform -%}
        <p class="auth__switch">{{ 'customer.auth.have_account' | t }} <a class="text-link" href="{{ routes.account_login_url }}" data-auth-tab>{{ 'customer.login.title' | t }}</a></p>
      {%- else -%}
        <h1 class="auth__heading h3">{{ 'customer.login.title' | t }}</h1>
        <div id="RecoverPassword" hidden data-recover>
          {%- form 'recover_customer_password', class: 'form-grid' -%}
            {%- if form.posted_successfully? -%}<p class="form-message form-message--success" role="status">{{ 'customer.recover.success' | t }}</p>{%- endif -%}
            {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
            <div class="field"><label for="RecoverEmail">{{ 'customer.email' | t }}</label><input class="input" type="email" id="RecoverEmail" name="email" autocomplete="email" required></div>
            <button class="btn btn--full" type="submit">{{ 'customer.recover.submit' | t }}</button>
            <a href="#login" class="text-link" data-recover-toggle>{{ 'general.cancel' | t }}</a>
          {%- endform -%}
        </div>
        <div data-login>
          <p class="auth__offer" data-auth-offer hidden>{% render 'icon', name: 'tag', class: 'icon--sm' %}<span>{{ 'customer.auth.offer_login' | t }}</span></p>
          {%- form 'customer_login', class: 'form-grid auth__form' -%}
            <input type="hidden" name="return_to" value="{{ routes.account_url }}" data-auth-return>
            {%- if form.errors -%}<div class="form-message form-message--error" role="alert" tabindex="-1" data-auth-errors>{{ form.errors | default_errors }}</div>{%- endif -%}
            <div class="field"><label for="LoginEmail">{{ 'customer.email' | t }}</label><input class="input" type="email" id="LoginEmail" name="customer[email]" autocomplete="email" autocapitalize="off" spellcheck="false" required></div>
            <div class="field">
              <label for="LoginPassword">{{ 'customer.password' | t }}</label>
              <div class="auth__pw">
                <input class="input" type="password" id="LoginPassword" name="customer[password]" autocomplete="current-password" required>
                <button type="button" class="auth__eye" data-pw-toggle aria-controls="LoginPassword" aria-pressed="false" aria-label="{{ 'customer.auth.show_password' | t }}">{% render 'icon', name: 'eye' %}</button>
              </div>
            </div>
            <a href="#recover" class="text-link auth__forgot" data-recover-toggle>{{ 'customer.login.forgot' | t }}</a>
            <button class="btn btn--full" type="submit">{{ 'customer.login.submit' | t }}</button>
          {%- endform -%}
          <p class="auth__switch">{{ 'customer.login.new' | t }} <a class="text-link" href="{{ routes.account_register_url }}" data-auth-tab>{{ 'customer.register.title' | t }}</a></p>
          {%- if shop.checkout.guest_login -%}
            {%- form 'guest_login' -%}<button class="btn btn--outline btn--full" type="submit">{{ 'customer.login.guest' | t }}</button>{%- endform -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Konto: Anmelden & Registrieren",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Dein Konto. Dein erster Fang." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Einmal anlegen, schneller bestellen und den Willkommensrabatt direkt mitnehmen." },
    { "type": "image_picker", "id": "image", "label": "Hintergrundbild links", "info": "Wird stark abgedunkelt. Hochformat passt gut." },
    { "type": "text", "id": "code", "label": "Willkommens-Rabattcode", "default": "WILLKOMMEN10", "info": "Wird nach der Registrierung automatisch in den Warenkorb gelegt. Muss unter Rabatte angelegt sein (einmal pro Kunde). Leer lassen schaltet das aus." },
    { "type": "text", "id": "perk_discount", "label": "Vorteil Rabatt", "default": "10 % auf deine erste Bestellung," },
    { "type": "textarea", "id": "newsletter_text", "label": "Text Newsletter-Häkchen", "default": "Neue Köder, Fangtipps und Aktionen per E-Mail. Du bestätigst die Anmeldung per Link und kannst dich jederzeit abmelden." },
    { "type": "checkbox", "id": "newsletter_checked", "label": "Newsletter-Häkchen vorausgewählt", "default": false, "info": "Nach DSGVO nicht empfohlen." }
  ]
}
{% endschema %}
