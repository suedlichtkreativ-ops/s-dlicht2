<div class="page-width not-found">
  <div class="not-found__main">
    <p class="not-found__code display" aria-hidden="true"><span class="slant">404</span></p>
    <h1 class="h2">{{ 'not_found.title' | t }}</h1>
    <p class="lead muted">{{ 'not_found.text' | t }}</p>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form not-found__search">
      <label class="visually-hidden" for="NotFoundSearch">{{ 'header.search' | t }}</label>
      <input class="input" id="NotFoundSearch" type="search" name="q" placeholder="{{ 'header.search_placeholder' | t }}">
      <button class="btn btn--dark" type="submit">{{ 'header.search_submit' | t }}</button>
    </form>
    <a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
  </div>
  {%- assign menu = section.settings.menu -%}
  {%- if menu != blank and menu.links.size > 0 -%}
    <nav class="not-found__nav" aria-labelledby="NotFoundNav">
      <h2 class="h3" id="NotFoundNav">{{ 'not_found.nav' | t }}</h2>
      <ul class="not-found__links" role="list">
        {%- for link in menu.links -%}
          <li><a href="{{ link.url }}"><span>{{ link.title | escape }}</span>{% render 'icon', name: 'arrow' %}</a></li>
        {%- endfor -%}
      </ul>
    </nav>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "404",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menü „Direkt weiter“", "default": "main-menu", "info": "Die Hauptpunkte dieses Menüs erscheinen als Schnellzugriff." }
  ]
}
{% endschema %}
