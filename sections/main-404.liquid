<div class="page-width not-found">
  <p class="not-found__code display" aria-hidden="true"><span class="slant">404</span></p>
  <h1 class="h2">{{ 'not_found.title' | t }}</h1>
  <p class="lead muted">{{ 'not_found.text' | t }}</p>
  <form action="{{ routes.search_url }}" method="get" role="search" class="search-form" style="width:100%">
    <label class="visually-hidden" for="NotFoundSearch">{{ 'header.search' | t }}</label>
    <input class="input" id="NotFoundSearch" type="search" name="q" placeholder="{{ 'header.search_placeholder' | t }}">
    <button class="btn btn--dark" type="submit">{{ 'header.search_submit' | t }}</button>
  </form>
  <a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
</div>
{% schema %}
{ "name": "404", "settings": [] }
{% endschema %}
