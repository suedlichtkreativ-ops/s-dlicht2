{%- comment -%}
  News / Empfehlungen from a Shopify blog. Without a blog, shows example cards so the layout stays visible in the editor.
{%- endcomment -%}
{%- assign b = section.settings.blog -%}
<section class="section{% if section.settings.white %} section--white{% endif %}">
  <div class="page-width">
    <div class="section-head">
      <h2 class="section-title display">{% render 'slant-words', text: section.settings.heading %}</h2>
      {%- if b != blank -%}<a class="text-link" href="{{ b.url }}">{{ 'blog.view_all' | t }}</a>{%- endif -%}
    </div>
    <ul class="posts" role="list">
      {%- if b != blank and b.articles_count > 0 -%}
        {%- for article in b.articles limit: section.settings.limit -%}
          <li>
            <a class="post" href="{{ article.url }}">
              <div class="media">
                {%- if article.image -%}
                  {% render 'image', image: article.image, sizes: '(min-width: 990px) 44vw, 100vw', alt: '' %}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              <span class="post__meta">{{ article.published_at | time_tag: format: 'date' }}</span>
              <span class="post__title">{{ article.title | escape }}</span>
              {%- if article.excerpt != blank -%}<span class="post__excerpt muted">{{ article.excerpt | strip_html | truncatewords: 22 }}</span>{%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- assign demo_titles = 'Hecht, Zander oder Barsch? So findest du die richtige Angelrute|Die richtige Köderwahl: So erhöhst du deine Fangchancen' | split: '|' -%}
        {%- for t in demo_titles -%}
          <li>
            <div class="post">
              <div class="media">{{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}</div>
              <span class="post__title">{{ t }}</span>
            </div>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Blog-Beiträge",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "News, Bundles & Empfehlungen" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "limit", "label": "Anzahl Beiträge", "min": 2, "max": 6, "step": 1, "default": 2 },
    { "type": "checkbox", "id": "white", "label": "Weißer Hintergrund", "default": false }
  ],
  "presets": [{ "name": "Blog-Beiträge" }]
}
{% endschema %}
