{%- if section.blocks.size > 0 -%}
  <div class="announcement" role="region" aria-label="{{ 'general.announcements' | t }}" data-announcement data-interval="{{ section.settings.interval }}">
    <ul class="page-width announcement__list" role="list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          {%- if section.settings.show_check -%}{% render 'icon', name: 'check' %}{%- endif -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
          {%- else -%}
            {{ block.settings.text | escape }}
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Ansage-Leiste",
  "class": "announcement-section",
  "max_blocks": 6,
  "settings": [
    { "type": "checkbox", "id": "show_check", "label": "Haken vor jedem Hinweis", "default": true },
    { "type": "range", "id": "interval", "label": "Wechsel alle", "info": "Wenn nicht alle Hinweise in eine Zeile passen (z. B. auf dem Handy), wechseln sie automatisch.", "min": 3, "max": 8, "step": 1, "unit": "s", "default": 4 }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Hinweis",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Schnell geliefert mit DPD" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Ansage-Leiste", "blocks": [{ "type": "message" }] }]
}
{% endschema %}
