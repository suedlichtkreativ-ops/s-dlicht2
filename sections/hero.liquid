{%- liquid
  assign slides = section.blocks | where: 'type', 'slide'
  assign first_tag = 'h2'
  if section.index == 1
    assign first_tag = 'h1'
  endif
  assign is_slider = false
  if slides.size > 1
    assign is_slider = true
  endif
  assign interval_ms = section.settings.interval | times: 1000
-%}
<section
  class="hero on-dark{% if is_slider %} hero--slider{% endif %}{% if section.settings.show_line %} hero--line{% endif %}"
  data-hero
  {% if section.settings.animate %}data-animate{% endif %}
  {% if is_slider %}data-hero-slider data-interval="{{ interval_ms }}"{% if section.settings.autoplay %} data-autoplay{% endif %} aria-roledescription="carousel" aria-label="{{ 'hero.carousel' | t }}"{% endif %}
  style="--hero-interval: {{ interval_ms }}ms;"
>
  {%- comment -%} Layer 1: backgrounds (cross-fade on their own, so the line can sit between photo and text) {%- endcomment -%}
  <div class="hero__backdrops" aria-hidden="true">
    {%- for block in slides -%}
      <div class="hero__backdrop{% if forloop.first %} is-active{% endif %}" data-backdrop>
        {%- if block.settings.image != blank -%}
          <div class="hero__media{% if block.settings.image_mobile != blank %} hero__media--desktop{% endif %}">
            {%- if forloop.first -%}
              {% render 'image', image: block.settings.image, sizes: '100vw', loading: 'eager', alt: '' %}
            {%- else -%}
              {% render 'image', image: block.settings.image, sizes: '100vw', loading: 'lazy', alt: '' %}
            {%- endif -%}
          </div>
          {%- if block.settings.image_mobile != blank -%}
            <div class="hero__media hero__media--mobile">
              {%- if forloop.first -%}
                {% render 'image', image: block.settings.image_mobile, sizes: '100vw', loading: 'eager', alt: '' %}
              {%- else -%}
                {% render 'image', image: block.settings.image_mobile, sizes: '100vw', loading: 'lazy', alt: '' %}
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  {%- comment -%} Layer 2: the fishing line with a real lure on a snap. One lure per slide. {%- endcomment -%}
  {%- if section.settings.show_line -%}
    <div class="hero__line-art" style="--line-x: {{ section.settings.line_position }}%;" data-hero-line>
      <span class="hero__rig" data-rig>
        <span class="hero__string" aria-hidden="true"></span>
        <svg class="hero__snap" viewBox="0 0 16 44" width="16" height="44" aria-hidden="true" focusable="false">
          <circle cx="8" cy="3.5" r="2.6"/>
          <rect x="5" y="6.5" width="6" height="9" rx="3"/>
          <circle cx="8" cy="18.5" r="2.6"/>
          <path d="M8 21.2 C3 24 3.2 32 5 37 C6 40 10 40 11 37 C12.6 32 12.8 26.5 9.6 23.4"/>
        </svg>
        <span class="hero__tackle" data-tackle>
          {%- for block in slides -%}
            {%- liquid
              assign lure_src = nil
              if block.settings.lure_image != blank
                assign lure_src = block.settings.lure_image | image_url: width: 640
              elsif block.settings.lure_asset != blank
                assign lure_src = block.settings.lure_asset | asset_url
              endif
            -%}
            {%- if lure_src -%}
              {%- liquid
                assign lure_product = block.settings.lure_product
                assign lure_style = block.settings.lure_style | default: 'lure'
                assign lure_label = block.settings.lure_label
                if block.settings.lure_link != blank
                  assign lure_href = block.settings.lure_link
                elsif lure_style == 'tag'
                  comment
                    Price tag: new visitors go to sign-up (the code lands in the cart afterwards),
                    customers who are already logged in get the code straight into the cart.
                  endcomment
                  assign tag_code = block.settings.code | default: 'WILLKOMMEN10'
                  if customer
                    assign lure_href = routes.root_url | append: 'discount/' | append: tag_code | append: '?redirect=' | append: routes.cart_url
                  else
                    assign lure_href = routes.account_register_url | append: '?willkommen'
                  endif
                elsif lure_product != blank
                  assign lure_href = lure_product.url
                else
                  assign lure_href = block.settings.button_link | default: routes.all_products_collection_url
                endif
                if lure_label == blank
                  if lure_product != blank
                    assign lure_label = lure_product.title
                  else
                    assign lure_label = block.settings.button_label
                  endif
                endif
              -%}
              <a class="hero__lure{% if lure_style != 'lure' %} hero__lure--top hero__lure--{{ lure_style }}{% endif %}{% if forloop.first %} is-active{% endif %}" data-lure href="{{ lure_href }}"{% unless forloop.first %} tabindex="-1" aria-hidden="true"{% endunless %}>
                <img src="{{ lure_src }}" alt="" width="640" height="{% if lure_style == 'lure' %}200{% elsif lure_style == 'tag' %}1040{% else %}512{% endif %}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
                <span class="visually-hidden">{{ lure_label | escape }}</span>
              </a>
            {%- endif -%}
          {%- endfor -%}
          <span class="hero__ripple" aria-hidden="true"></span>
        </span>
      </span>
    </div>
  {%- endif -%}

  {%- comment -%} Layer 3: copy and buttons {%- endcomment -%}
  <div class="hero__slides">
    {%- for block in slides -%}
      {%- liquid
        assign tag = 'h2'
        if forloop.first
          assign tag = first_tag
        endif
        assign lines = block.settings.heading | newline_to_br | split: '<br />'
      -%}
      <div
        class="hero__slide{% if forloop.first %} is-active{% endif %}"
        id="HeroSlide-{{ section.id }}-{{ forloop.index }}"
        data-slide
        {% if is_slider %}role="tabpanel" aria-roledescription="slide" aria-label="{{ forloop.index }} / {{ slides.size }}"{% endif %}
        {% unless forloop.first %}aria-hidden="true" inert{% endunless %}
        {{ block.shopify_attributes }}
      >
        <div class="page-width hero__inner">
          <{{ tag }} class="hero__title display">
            {%- for line in lines -%}
              {%- assign clean = line | strip -%}
              {%- if clean == blank -%}{%- continue -%}{%- endif -%}
              {%- assign words = clean | escape | split: ' ' -%}
              <span class="hero__line"><span class="hero__line-inner"><span style="--i: {{ forloop.index0 }}">{% for w in words %}<span class="slant">{{ w }}</span>{% unless forloop.last %} {% endunless %}{% endfor %}</span></span></span>
            {%- endfor -%}
          </{{ tag }}>

          {%- if block.settings.text != blank -%}
            <div class="hero__text">{{ block.settings.text }}</div>
          {%- endif -%}

          {%- if block.settings.signup -%}
            {%- comment -%} Code comes by e-mail after the newsletter sign-up in the welcome pop-up. {%- endcomment -%}
            {%- assign signup_label = block.settings.signup_label | default: '' -%}
            {%- if signup_label == blank -%}{%- assign signup_label = 'hero.signup' | t -%}{%- endif -%}
            <p class="hero__code">
              <button type="button" class="btn btn--slant hero__signup" data-drawer-open="welcome" aria-haspopup="dialog" aria-controls="Welcome">{{ signup_label | escape }}</button>
            </p>
          {%- elsif block.settings.code != blank -%}
            <p class="hero__code">
              <span>{{ 'hero.code_label' | t }}</span>
              <button type="button" class="hero__code-btn" data-copy="{{ block.settings.code | escape }}" data-copied="{{ 'hero.copied' | t }}">
                <strong>{{ block.settings.code | escape }}</strong>
                <span class="hero__code-hint" data-copy-hint>{{ 'hero.copy' | t }}</span>
              </button>
            </p>
          {%- endif -%}

          {%- if block.settings.button_label != blank or block.settings.button2_label != blank -%}
            <div class="hero__band">
              {%- if block.settings.button_label != blank -%}
                <a class="btn btn--dark btn--slant" href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">{{ block.settings.button_label | escape }}</a>
              {%- endif -%}
              {%- if block.settings.button2_label != blank -%}
                <a class="btn btn--outline btn--slant" href="{{ block.settings.button2_link | default: '#laden' }}">{{ block.settings.button2_label | escape }}</a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if is_slider -%}
    <div class="page-width hero__controls">
      <div class="hero__tabs" role="tablist" aria-label="{{ 'hero.carousel' | t }}">
        {%- for block in slides -%}
          <button type="button" class="hero__tab" role="tab" data-slide-to="{{ forloop.index0 }}" aria-controls="HeroSlide-{{ section.id }}-{{ forloop.index }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"{% unless forloop.first %} tabindex="-1"{% endunless %}>
            <span class="hero__tab-label">{{ block.settings.label | default: forloop.index | escape }}</span>
            <span class="hero__tab-bar" aria-hidden="true"><i></i></span>
          </button>
        {%- endfor -%}
      </div>
      {%- if section.settings.autoplay -%}
        <button type="button" class="hero__pause" data-hero-pause aria-pressed="false" aria-label="{{ 'hero.pause' | t }}" data-label-pause="{{ 'hero.pause' | t }}" data-label-play="{{ 'hero.play' | t }}">
          <svg class="hero__pause-icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><rect x="3.5" y="2.5" width="3" height="11"/><rect x="9.5" y="2.5" width="3" height="11"/></svg>
          <svg class="hero__play-icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path d="M4 2.5 L13 8 L4 13.5 Z"/></svg>
        </button>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.settings.show_cue -%}
    <a class="hero__cue" href="#hero-next-{{ section.id }}">
      <span>{{ 'hero.scroll_cue' | t }}</span>
      <span class="hero__cue-line" aria-hidden="true"></span>
    </a>
  {%- endif -%}
</section>
<span id="hero-next-{{ section.id }}"></span>

{% schema %}
{
  "name": "Hero",
  "class": "hero-section",
  "max_blocks": 5,
  "settings": [
    { "type": "checkbox", "id": "autoplay", "label": "Motive automatisch wechseln", "info": "Pausiert, solange die Maus über dem Bereich ist, und bei „Bewegung reduzieren“ im Betriebssystem.", "default": true },
    { "type": "range", "id": "interval", "label": "Anzeigedauer pro Motiv", "min": 5, "max": 12, "step": 1, "unit": "s", "default": 7 },
    { "type": "checkbox", "id": "show_line", "label": "Angelschnur mit Köder zeigen", "info": "Beim Überfahren mit der Maus (am Handy: Antippen der Schnur) zupft sie wie bei einem Biss. Ein Klick auf den Köder öffnet das Produkt.", "default": true },
    { "type": "range", "id": "line_position", "label": "Position der Angelschnur", "info": "Abstand vom linken Rand. Am besten eine ruhige Stelle im Bild wählen, z. B. das Wasser.", "min": 30, "max": 90, "step": 1, "unit": "%", "default": 52 },
    { "type": "checkbox", "id": "show_cue", "label": "Scroll-Hinweis anzeigen", "default": true },
    { "type": "checkbox", "id": "animate", "label": "Einstiegsanimation", "default": true }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Motiv",
      "settings": [
        { "type": "text", "id": "label", "label": "Name im Reiter", "info": "Kurz, z. B. „Topwater“. Steht unten als Reiter.", "default": "Sortiment" },
        { "type": "image_picker", "id": "image", "label": "Hintergrundbild", "info": "Stimmungsfoto ohne eingebrannten Text, mind. 2400 px breit. Links unten wird es für die Schrift abgedunkelt." },
        { "type": "image_picker", "id": "image_mobile", "label": "Hintergrundbild Handy (optional)", "info": "Hochformat. Ohne Angabe wird das Desktop-Bild verwendet." },
        { "type": "textarea", "id": "heading", "label": "Überschrift", "info": "Jede Zeile wird eine eigene Zeile. Kurze Wörter wirken am besten.", "default": "Köder.\nRuten.\nRat vom Lech." },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "text", "id": "code", "label": "Rabattcode (optional)", "info": "Wird als Feld zum Kopieren gezeigt. Der Code muss unter Rabatte in Shopify angelegt sein." },
        { "type": "checkbox", "id": "signup", "label": "Code per Newsletter-Anmeldung", "info": "Statt des Codes erscheint ein Button, der das Willkommens-Pop-up mit E-Mail-Feld öffnet.", "default": false },
        { "type": "text", "id": "signup_label", "label": "Button-Text Anmeldung", "default": "10 % sichern" },
        { "type": "text", "id": "button_label", "label": "Button 1", "default": "Sortiment ansehen" },
        { "type": "url", "id": "button_link", "label": "Link Button 1" },
        { "type": "text", "id": "button2_label", "label": "Button 2" },
        { "type": "url", "id": "button2_link", "label": "Link Button 2", "info": "Leer lassen, um zum Abschnitt „Laden“ zu springen." },
        { "type": "header", "content": "Köder an der Angelschnur" },
        { "type": "image_picker", "id": "lure_image", "label": "Köder-Bild", "info": "Freigestelltes PNG, Kopf (Öse) nach links. Er hängt am Snap." },
        { "type": "text", "id": "lure_asset", "label": "Köder aus dem Theme", "info": "Wird genutzt, wenn kein Bild gewählt ist. Mitgeliefert: lure-fernlaeufer.webp, lure-oberflaechenblitz.webp, lure-kurzlaeufer.webp, lure-rasselminnow.webp" },
        { "type": "product", "id": "lure_product", "label": "Köder-Produkt", "info": "Ein Klick auf den Köder öffnet dieses Produkt." },
        {
          "type": "select", "id": "lure_style", "label": "Was hängt an der Schnur?", "default": "lure",
          "options": [
            { "value": "lure", "label": "Köder (hängt am Kopf)" },
            { "value": "box", "label": "Köderkiste (hängt am Griff)" },
            { "value": "tag", "label": "Preisschild (Klick führt zur Registrierung)" }
          ],
          "info": "Köderkiste: lure-koederkiste.webp. Preisschild: lure-preisschild-10.webp. Beim Preisschild landet der Rabattcode dieser Folie nach der Registrierung im Warenkorb."
        },
        { "type": "url", "id": "lure_link", "label": "Link (optional)", "info": "Überschreibt das Ziel, z. B. „Alle Produkte“ für die Köderkiste." },
        { "type": "text", "id": "lure_label", "label": "Beschriftung für Screenreader (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "slide", "settings": { "label": "Sortiment", "heading": "Köder.\nRuten.\nRat vom Lech.", "lure_asset": "lure-fernlaeufer.webp" } }
      ]
    }
  ]
}
{% endschema %}
