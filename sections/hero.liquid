{%- liquid
  assign lines = section.blocks | where: 'type', 'line'
  assign heading_tag = 'h2'
  if section.index == 1
    assign heading_tag = 'h1'
  endif
-%}
<section class="hero on-dark" data-hero{% if section.settings.animate %} data-animate{% endif %}>
  {%- if section.settings.image != blank -%}
    <div class="hero__media">
      {% render 'image', image: section.settings.image, sizes: '100vw', loading: 'eager', alt: '' %}
    </div>
  {%- endif -%}

  <div class="hero__line-art" aria-hidden="true">
    <span class="hero__string"></span>
    <svg class="hero__hook" viewBox="0 0 40 72" width="40" height="72">
      <circle cx="20" cy="7" r="5.5"/>
      <path d="M20 12.5 V48 C20 64 3 66 2 52 V44 L9 50"/>
    </svg>
  </div>

  <div class="page-width hero__inner">
    <{{ heading_tag }} class="hero__title display">
      {%- for block in lines -%}
        {%- assign words = block.settings.text | escape | split: ' ' -%}
        <span class="hero__line" {{ block.shopify_attributes }}><span class="hero__line-inner"><span style="--i: {{ forloop.index0 }}">{% for w in words %}<span class="slant">{{ w }}</span>{% unless forloop.last %} {% endunless %}{% endfor %}</span></span></span>
      {%- else -%}
        <span class="hero__line"><span class="hero__line-inner"><span>{% render 'slant-words', text: shop.name %}</span></span></span>
      {%- endfor -%}
    </{{ heading_tag }}>

    {%- if section.settings.text != blank -%}
      <div class="hero__text">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.settings.button_label != blank or section.settings.button2_label != blank -%}
      <div class="hero__band">
        {%- if section.settings.button_label != blank -%}
          <a class="btn btn--dark btn--slant" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
        {%- if section.settings.button2_label != blank -%}
          <a class="btn btn--outline btn--slant" href="{{ section.settings.button2_link | default: '#laden' }}">{{ section.settings.button2_label | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_cue -%}
      <a class="hero__cue" href="#hero-next-{{ section.id }}">
        <span class="hero__cue-line" aria-hidden="true"></span>
        <span>{{ 'hero.scroll_cue' | t }}</span>
      </a>
    {%- endif -%}
  </div>
</section>
<span id="hero-next-{{ section.id }}"></span>

{% schema %}
{
  "name": "Hero",
  "class": "hero-section",
  "max_blocks": 4,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hintergrundbild (optional)", "info": "Stimmungsvolles Wasser- oder Landschaftsfoto, mind. 2400 px breit. Wird links unten abgedunkelt, damit die Schrift lesbar bleibt. Ohne Bild: schwarze Fläche." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Kunstköder, Ruten und Zubehör für Hecht, Zander, Barsch und Forelle. Ausgesucht von Anglern aus Landsberg am Lech.</p>" },
    { "type": "text", "id": "button_label", "label": "Button 1", "default": "Sortiment ansehen" },
    { "type": "url", "id": "button_link", "label": "Link Button 1" },
    { "type": "text", "id": "button2_label", "label": "Button 2", "default": "Abholung im Laden" },
    { "type": "url", "id": "button2_link", "label": "Link Button 2", "info": "Leer lassen, um zum Abschnitt „Laden“ zu springen." },
    { "type": "checkbox", "id": "show_cue", "label": "Scroll-Hinweis anzeigen", "default": true },
    { "type": "checkbox", "id": "animate", "label": "Einstiegsanimation", "default": true }
  ],
  "blocks": [
    {
      "type": "line",
      "name": "Zeile",
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Köder." }]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "line", "settings": { "text": "Köder." } },
        { "type": "line", "settings": { "text": "Ruten." } },
        { "type": "line", "settings": { "text": "Rat vom Lech." } }
      ]
    }
  ]
}
{% endschema %}
