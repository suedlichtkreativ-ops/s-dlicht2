{%- comment -%}
  Köderberatung by water depth: surface, mid water, bottom as a water column that gets darker towards the ground.
{%- endcomment -%}
<section class="section advice-zones on-dark" id="wassertiefe">
  <div class="page-width">
    <h2 class="section-title display">{% render 'slant-words', text: section.settings.heading %}</h2>
    {%- if section.settings.text != blank -%}<p class="muted advice__intro">{{ section.settings.text | escape }}</p>{%- endif -%}
    <ol class="advice-zones__column" role="list">
      {%- for block in section.blocks -%}
        <li class="advice-zones__zone advice-zones__zone--{{ forloop.index }}" {{ block.shopify_attributes }}>
          <div class="advice-zones__depth"><span class="advice-zones__num">{{ forloop.index }}</span><span>{{ block.settings.depth | escape }}</span></div>
          <div class="advice-zones__body">
            <h3 class="advice-zones__title display">{{ block.settings.title | escape }}</h3>
            <div class="rte">{{ block.settings.text }}</div>
          </div>
          <ul class="advice-zones__chips" role="list">
            {%- for i in (1..5) -%}
              {%- assign key = 'type_' | append: i -%}
              {%- assign t = block.settings[key] -%}
              {%- if t != blank -%}<li><a class="chip chip--dark" href="{{ t.url }}">{{ t.title | escape }}</a></li>{%- endif -%}
            {%- endfor -%}
          </ul>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Köderberatung: Wassertiefe",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Nach Wassertiefe" },
    { "type": "text", "id": "text", "label": "Text", "default": "Wo der Fisch steht, entscheidet über den Köder." }
  ],
  "blocks": [
    {
      "type": "zone", "name": "Zone",
      "settings": [
        { "type": "text", "id": "depth", "label": "Tiefe", "default": "Oberfläche" },
        { "type": "text", "id": "title", "label": "Überschrift", "default": "Oben" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "collection", "id": "type_1", "label": "Köderart 1" },
        { "type": "collection", "id": "type_2", "label": "Köderart 2" },
        { "type": "collection", "id": "type_3", "label": "Köderart 3" },
        { "type": "collection", "id": "type_4", "label": "Köderart 4" },
        { "type": "collection", "id": "type_5", "label": "Köderart 5" }
      ]
    }
  ],
  "presets": [{ "name": "Köderberatung: Wassertiefe" }]
}
{% endschema %}
