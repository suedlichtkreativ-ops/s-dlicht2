<footer class="footer on-dark">
  <div class="page-width footer__top">
    <div class="footer__brand">
      <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        {%- if settings.logo != blank -%}
          {{ settings.logo | image_url: width: 400 | image_tag: widths: '200, 400', sizes: '192px', alt: shop.name, loading: 'lazy' }}
        {%- else -%}
          <span class="wordmark" style="color:var(--ink)"><span>{{ shop.name | escape }}</span></span>
        {%- endif -%}
      </a>
      {%- if section.settings.text != blank -%}
        <p class="footer__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      <ul class="footer__social" role="list">
        {%- assign networks = 'instagram,facebook,youtube,tiktok' | split: ',' -%}
        {%- for net in networks -%}
          {%- assign key = 'social_' | append: net -%}
          {%- if settings[key] != blank -%}
            <li><a class="icon-btn" href="{{ settings[key] }}" target="_blank" rel="noopener" aria-label="{{ net | capitalize }}">{% render 'icon', name: net %}</a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>

    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
        {%- case block.type -%}
          {%- when 'menu' -%}
            <ul class="footer__links" role="list">
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {%- endfor -%}
            </ul>
          {%- when 'store' -%}
            <p class="footer__text">{{ settings.store_address }}</p>
            {%- if settings.store_hours != blank -%}<p class="footer__text" style="margin-top:.75rem">{{ settings.store_hours }}</p>{%- endif -%}
            <ul class="footer__links" role="list" style="margin-top:.75rem">
              {%- if settings.store_phone != blank -%}<li><a href="tel:{{ settings.store_phone | remove: ' ' | remove: '/' }}">{{ settings.store_phone }}</a></li>{%- endif -%}
              {%- if settings.store_email != blank -%}<li><a href="mailto:{{ settings.store_email }}">{{ settings.store_email }}</a></li>{%- endif -%}
            </ul>
          {%- when 'text' -%}
            <div class="footer__text rte">{{ block.settings.text }}</div>
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>

  <div class="page-width footer__bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</p>
    {%- if section.settings.legal_menu != blank -%}
      <ul role="list">
        {%- for link in section.settings.legal_menu.links -%}
          <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if section.settings.show_payment and shop.enabled_payment_types.size > 0 -%}
      <ul class="payment-icons" role="list" aria-label="{{ 'footer.payment' | t }}">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "text", "label": "Kurztext", "default": "Angelbedarf aus Landsberg am Lech. Versand deutschlandweit, Abholung im Laden." },
    { "type": "link_list", "id": "legal_menu", "label": "Rechtliches-Menü", "info": "Impressum, Datenschutz, AGB, Widerruf, Versand." },
    { "type": "checkbox", "id": "show_payment", "label": "Zahlungsarten anzeigen", "default": true }
  ],
  "blocks": [
    {
      "type": "menu", "name": "Menü",
      "settings": [
        { "type": "text", "id": "heading", "label": "Überschrift", "default": "Sortiment" },
        { "type": "link_list", "id": "menu", "label": "Menü", "default": "footer" }
      ]
    },
    {
      "type": "store", "name": "Laden",
      "settings": [{ "type": "text", "id": "heading", "label": "Überschrift", "default": "Laden" }]
    },
    {
      "type": "text", "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Überschrift", "default": "Service" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Fragen zu Ausrüstung oder Bestellung? Ruf an oder schreib uns.</p>" }
      ]
    }
  ]
}
{% endschema %}
