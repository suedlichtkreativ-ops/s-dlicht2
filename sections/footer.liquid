<footer class="footer on-dark">
  <div class="page-width footer__top">
    <div class="footer__brand">
      <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        {%- if settings.logo != blank -%}
          {{ settings.logo | image_url: width: 400 | image_tag: widths: '200, 400', sizes: '192px', alt: shop.name, loading: 'lazy' }}
        {%- else -%}
          <span class="wordmark" style="color:var(--ink)"><span>{{ shop.name | escape }}</span></span>
        {%- endif -%}
      </a>
      {%- if section.settings.text != blank -%}
        <p class="footer__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {% render 'social-links', class: 'footer__social' %}
    </div>

    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
        {%- case block.type -%}
          {%- when 'menu' -%}
            <ul class="footer__links" role="list">
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {%- endfor -%}
            </ul>
          {%- when 'store' -%}
            <p class="footer__text">{{ settings.store_address }}</p>
            {%- if settings.store_hours != blank -%}<p class="footer__text" style="margin-top:.75rem">{{ settings.store_hours }}</p>{%- endif -%}
            <ul class="footer__links" role="list" style="margin-top:.75rem">
              {%- if settings.store_phone != blank -%}<li><a href="tel:{{ settings.store_phone | remove: ' ' | remove: '/' }}">{{ settings.store_phone }}</a></li>{%- endif -%}
              {%- if settings.store_email != blank -%}<li><a href="mailto:{{ settings.store_email }}">{{ settings.store_email }}</a></li>{%- endif -%}
            </ul>
          {%- when 'text' -%}
            <div class="footer__text rte">{{ block.settings.text }}</div>
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>

  <div class="page-width footer__bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</p>
    {%- if section.settings.legal_menu != blank -%}
      <ul role="list">
        {%- for link in section.settings.legal_menu.links -%}
          <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if section.settings.badge_link != blank -%}
      {%- comment -%} Seal of the provider of the legal texts (e.g. "AGB by IT-Recht Kanzlei"). {%- endcomment -%}
      <a class="legal-badge" href="{{ section.settings.badge_link }}" target="_blank" rel="noopener" data-legal-badge>
        {%- if section.settings.badge_image_url != blank -%}
          <img src="{{ section.settings.badge_image_url | escape }}" alt="{{ section.settings.badge_text | escape }}" height="36" loading="lazy" data-legal-badge-img>
        {%- endif -%}
        <span class="legal-badge__text"{% if section.settings.badge_image_url != blank %} hidden{% endif %}>{{ section.settings.badge_text | escape }}</span>
      </a>
    {%- endif -%}
    {%- if section.settings.show_payment and shop.enabled_payment_types.size > 0 -%}
      <ul class="payment-icons" role="list" aria-label="{{ 'footer.payment' | t }}">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "text", "label": "Kurztext", "default": "Angelköder und Tackle aus Landsberg am Lech. Versand innerhalb Deutschlands, Abholung vor Ort." },
    { "type": "link_list", "id": "legal_menu", "label": "Rechtliches-Menü", "info": "Impressum, Datenschutz, AGB, Widerruf, Versand." },
    { "type": "checkbox", "id": "show_payment", "label": "Zahlungsarten anzeigen", "default": true },
    { "type": "header", "content": "Siegel Rechtstexte" },
    { "type": "url", "id": "badge_link", "label": "Link", "info": "Leer lassen, um das Siegel auszublenden.", "default": "https://www.it-recht-kanzlei.de/" },
    { "type": "text", "id": "badge_image_url", "label": "Bild-Adresse des Siegels", "info": "Vom Anbieter der Rechtstexte (Mandantenbereich). Ohne Bild erscheint der Text.", "default": "https://www.it-recht-kanzlei.de/logo/Copyright-Logo_AGB.png?i=6adfc-5157e-39c7-907d-1" },
    { "type": "text", "id": "badge_text", "label": "Text", "default": "AGB by IT-Recht Kanzlei" }
  ],
  "blocks": [
    {
      "type": "menu", "name": "Menü",
      "settings": [
        { "type": "text", "id": "heading", "label": "Überschrift", "default": "Sortiment" },
        { "type": "link_list", "id": "menu", "label": "Menü", "default": "footer" }
      ]
    },
    {
      "type": "store", "name": "Kontakt",
      "settings": [{ "type": "text", "id": "heading", "label": "Überschrift", "default": "Kontakt" }]
    },
    {
      "type": "text", "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Überschrift", "default": "Service" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Fragen zu Ausrüstung oder Bestellung? Ruf an oder schreib uns.</p>" }
      ]
    }
  ]
}
{% endschema %}
