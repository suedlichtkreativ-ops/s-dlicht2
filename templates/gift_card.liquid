{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ 'gift_card.title' | t }} – {{ shop.name }}</title>
    {% render 'theme-styles' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
  </head>
  <body>
    <main class="page-width" style="padding-block:4rem;display:grid;gap:1.5rem;justify-items:start;max-width:40rem">
      <h1 class="h2">{{ 'gift_card.title' | t }}</h1>
      <p class="display" style="font-size:4rem"><span class="slant">{{ gift_card.balance | money }}</span></p>
      {%- if gift_card.expired or gift_card.enabled == false -%}
        <p class="form-message form-message--error">{{ 'gift_card.expired' | t }}</p>
      {%- endif -%}
      <p class="label">{{ 'gift_card.code' | t }}</p>
      <p class="input" style="display:flex;align-items:center;font-weight:700;letter-spacing:.05em">{{ gift_card.code | format_code }}</p>
      <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}"></div>
      <a class="btn" href="{{ shop.url }}">{{ 'cart.continue' | t }}</a>
      {%- if gift_card.pass_url -%}<a href="{{ gift_card.pass_url }}"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="Apple Wallet"></a>{%- endif -%}
    </main>
    <script>
      window.addEventListener('load', function () {
        var el = document.getElementById('QrCode');
        if (window.QRCode && el) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
      });
    </script>
  </body>
</html>
