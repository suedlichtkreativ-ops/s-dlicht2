<div class="page-width" style="padding-block:clamp(2.5rem,6vw,5rem)">
<div class="stack" style="--stack:2rem">
  <div style="display:flex;justify-content:space-between;align-items:end;flex-wrap:wrap;gap:1rem">
    <h1 class="h1">{{ 'customer.account.title' | t }}</h1>
    <a class="text-link" href="{{ routes.account_logout_url }}">{{ 'customer.account.logout' | t }}</a>
  </div>
  <div class="cart-page">
    <div>
      <h2 class="h3" style="margin-bottom:1rem">{{ 'customer.account.orders' | t }}</h2>
      {%- paginate customer.orders by 20 -%}
        {%- if customer.orders.size > 0 -%}
          <table class="table">
            <thead><tr><th>{{ 'customer.order.number' | t }}</th><th>{{ 'customer.order.date' | t }}</th><th>{{ 'customer.order.status' | t }}</th><th>{{ 'customer.order.total' | t }}</th></tr></thead>
            <tbody>
              {%- for order in customer.orders -%}
                <tr><td><a class="text-link" href="{{ order.customer_url }}">{{ order.name }}</a></td><td>{{ order.created_at | time_tag: format: 'date' }}</td><td>{{ order.fulfillment_status_label }}</td><td class="price">{{ order.total_price | money_without_currency | append: ' €' }}</td></tr>
              {%- endfor -%}
            </tbody>
          </table>
          {% render 'pagination', paginate: paginate %}
        {%- else -%}
          <p class="muted">{{ 'customer.account.no_orders' | t }}</p>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
    <div class="cart-summary">
      <h2 class="h3">{{ 'customer.account.details' | t }}</h2>
      <p>{{ customer.name }}<br>{{ customer.email }}</p>
      {{ customer.default_address | format_address }}
      <a class="text-link" href="{{ routes.account_addresses_url }}">{{ 'customer.addresses.title' | t }} ({{ customer.addresses_count }})</a>
    </div>
  </div>
</div>
</div>
