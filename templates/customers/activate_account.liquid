<div class="page-width" style="padding-block:clamp(2.5rem,6vw,5rem)">
<div class="account-box">
  <h1 class="h2">{{ 'customer.activate.title' | t }}</h1>
  {%- form 'activate_customer_password', class: 'form-grid' -%}
    {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field"><label for="ActPw">{{ 'customer.password' | t }}</label><input class="input" type="password" id="ActPw" name="customer[password]" autocomplete="new-password" required></div>
    <div class="field"><label for="ActPw2">{{ 'customer.password_confirm' | t }}</label><input class="input" type="password" id="ActPw2" name="customer[password_confirmation]" autocomplete="new-password" required></div>
    <button class="btn" type="submit">{{ 'customer.activate.submit' | t }}</button>
    <button class="btn btn--outline" type="submit" name="decline">{{ 'customer.activate.decline' | t }}</button>
  {%- endform -%}
</div>
</div>
