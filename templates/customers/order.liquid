<div class="page-width" style="padding-block:clamp(2.5rem,6vw,5rem)">
<div class="stack" style="--stack:2rem">
  <a class="text-link" href="{{ routes.account_url }}">{{ 'customer.account.title' | t }}</a>
  <h1 class="h1">{{ 'customer.order.title' | t: name: order.name }}</h1>
  <p class="muted">{{ order.created_at | time_tag: format: 'date_at_time' }}{% if order.cancelled %} – {{ 'customer.order.cancelled' | t }}{% endif %}</p>
  <table class="table">
    <thead><tr><th>{{ 'customer.order.product' | t }}</th><th>{{ 'customer.order.quantity' | t }}</th><th>{{ 'customer.order.total' | t }}</th></tr></thead>
    <tbody>
      {%- for line_item in order.line_items -%}
        <tr><td>{{ line_item.title | link_to: line_item.product.url }}</td><td>{{ line_item.quantity }}</td><td class="price">{{ line_item.final_line_price | money_without_currency | append: ' €' }}</td></tr>
      {%- endfor -%}
    </tbody>
    <tfoot>
      <tr><td colspan="2">{{ 'cart.subtotal' | t }}</td><td class="price">{{ order.line_items_subtotal_price | money_without_currency | append: ' €' }}</td></tr>
      {%- for shipping_method in order.shipping_methods -%}<tr><td colspan="2">{{ shipping_method.title }}</td><td class="price">{{ shipping_method.price | money_without_currency | append: ' €' }}</td></tr>{%- endfor -%}
      <tr><th colspan="2">{{ 'customer.order.total' | t }}</th><th class="price">{{ order.total_price | money_without_currency | append: ' €' }}</th></tr>
    </tfoot>
  </table>
  <div class="form-grid form-grid--2">
    <div><h2 class="h3">{{ 'customer.order.billing' | t }}</h2>{{ order.billing_address | format_address }}</div>
    {%- if order.shipping_address -%}<div><h2 class="h3">{{ 'customer.order.shipping' | t }}</h2>{{ order.shipping_address | format_address }}</div>{%- endif -%}
  </div>
</div>
</div>
