<div class="page-width" style="padding-block:clamp(2.5rem,6vw,5rem)">
<div class="account-box">
  <h1 class="h2">{{ 'customer.login.title' | t }}</h1>
  <div id="RecoverPassword" hidden data-recover>
    {%- form 'recover_customer_password', class: 'form-grid' -%}
      {%- if form.posted_successfully? -%}<p class="form-message form-message--success" role="status">{{ 'customer.recover.success' | t }}</p>{%- endif -%}
      {{ form.errors | default_errors }}
      <div class="field"><label for="RecoverEmail">{{ 'customer.email' | t }}</label><input class="input" type="email" id="RecoverEmail" name="email" autocomplete="email" required></div>
      <button class="btn" type="submit">{{ 'customer.recover.submit' | t }}</button>
      <a href="#login" class="text-link" data-recover-toggle>{{ 'general.cancel' | t }}</a>
    {%- endform -%}
  </div>
  <div data-login>
    {%- form 'customer_login', class: 'form-grid' -%}
      {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="LoginEmail">{{ 'customer.email' | t }}</label><input class="input" type="email" id="LoginEmail" name="customer[email]" autocomplete="email" required></div>
      <div class="field"><label for="LoginPassword">{{ 'customer.password' | t }}</label><input class="input" type="password" id="LoginPassword" name="customer[password]" autocomplete="current-password" required></div>
      <a href="#recover" class="text-link" data-recover-toggle>{{ 'customer.login.forgot' | t }}</a>
      <button class="btn" type="submit">{{ 'customer.login.submit' | t }}</button>
    {%- endform -%}
    <p style="margin-top:1rem">{{ 'customer.login.new' | t }} <a class="text-link" href="{{ routes.account_register_url }}">{{ 'customer.register.title' | t }}</a></p>
    {%- if shop.checkout.guest_login -%}
      {%- form 'guest_login' -%}<button class="btn btn--outline" type="submit">{{ 'customer.login.guest' | t }}</button>{%- endform -%}
    {%- endif -%}
  </div>
</div>
</div>
