<div class="page-width" style="padding-block:clamp(2.5rem,6vw,5rem)">
<div class="stack" style="--stack:2rem">
  <a class="text-link" href="{{ routes.account_url }}">{{ 'customer.account.title' | t }}</a>
  <h1 class="h1">{{ 'customer.addresses.title' | t }}</h1>
  {%- paginate customer.addresses by 10 -%}
    <ul class="grid" role="list">
      {%- for address in customer.addresses -%}
        <li class="account-box">
          {%- if address == customer.default_address -%}<span class="badge">{{ 'customer.addresses.default' | t }}</span>{%- endif -%}
          {{ address | format_address }}
          <form method="post" action="{{ address.url }}"><input type="hidden" name="_method" value="delete"><button class="text-link" style="background:none;border:0;padding:0" type="submit" onclick="return confirm({{ 'customer.addresses.confirm_delete' | t | json | escape }})">{{ 'customer.addresses.delete' | t }}</button></form>
        </li>
      {%- endfor -%}
    </ul>
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
  <div class="account-box">
    <h2 class="h3">{{ 'customer.addresses.add' | t }}</h2>
    {%- form 'customer_address', customer.new_address, class: 'form-grid' -%}
      {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="form-grid form-grid--2">
        <div class="field"><label for="AddrFirst">{{ 'customer.first_name' | t }}</label><input class="input" id="AddrFirst" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name"></div>
        <div class="field"><label for="AddrLast">{{ 'customer.last_name' | t }}</label><input class="input" id="AddrLast" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name"></div>
      </div>
      <div class="field"><label for="AddrCompany">{{ 'customer.addresses.company' | t }}</label><input class="input" id="AddrCompany" name="address[company]" value="{{ form.company }}" autocomplete="organization"></div>
      <div class="field"><label for="AddrA1">{{ 'customer.addresses.address1' | t }}</label><input class="input" id="AddrA1" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1"></div>
      <div class="field"><label for="AddrA2">{{ 'customer.addresses.address2' | t }}</label><input class="input" id="AddrA2" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2"></div>
      <div class="form-grid form-grid--2">
        <div class="field"><label for="AddrZip">{{ 'customer.addresses.zip' | t }}</label><input class="input" id="AddrZip" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code"></div>
        <div class="field"><label for="AddrCity">{{ 'customer.addresses.city' | t }}</label><input class="input" id="AddrCity" name="address[city]" value="{{ form.city }}" autocomplete="address-level2"></div>
      </div>
      <div class="field"><label for="AddrCountry">{{ 'customer.addresses.country' | t }}</label><select class="select" id="AddrCountry" name="address[country]" autocomplete="country">{{ all_country_option_tags }}</select></div>
      <div class="field"><label for="AddrPhone">{{ 'customer.addresses.phone' | t }}</label><input class="input" type="tel" id="AddrPhone" name="address[phone]" value="{{ form.phone }}" autocomplete="tel"></div>
      <label class="facet__option"><input type="checkbox" name="address[default]" value="1"> {{ 'customer.addresses.set_default' | t }}</label>
      <button class="btn" type="submit">{{ 'customer.addresses.save' | t }}</button>
    {%- endform -%}
  </div>
</div>
</div>
