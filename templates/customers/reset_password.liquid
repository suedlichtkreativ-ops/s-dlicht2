<div class="page-width" style="padding-block:clamp(2.5rem,6vw,5rem)">
<div class="account-box">
  <h1 class="h2">{{ 'customer.reset.title' | t }}</h1>
  {%- form 'reset_customer_password', class: 'form-grid' -%}
    {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field"><label for="ResetPw">{{ 'customer.password' | t }}</label><input class="input" type="password" id="ResetPw" name="customer[password]" autocomplete="new-password" required></div>
    <div class="field"><label for="ResetPw2">{{ 'customer.password_confirm' | t }}</label><input class="input" type="password" id="ResetPw2" name="customer[password_confirmation]" autocomplete="new-password" required></div>
    <button class="btn" type="submit">{{ 'customer.reset.submit' | t }}</button>
  {%- endform -%}
</div>
</div>
