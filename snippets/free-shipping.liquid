{%- comment -%} Progress toward free shipping. Threshold from theme settings (in €). {%- endcomment -%}
{%- liquid
  assign threshold = settings.free_shipping_threshold | default: 0 | times: 100
  if threshold > 0
    assign remaining = threshold | minus: cart.total_price
    assign pct = cart.total_price | times: 100 | divided_by: threshold
    if pct > 100
      assign pct = 100
    endif
  endif
-%}
{%- if threshold > 0 -%}
  <div class="ship" data-ship-progress="{{ pct }}">
    <p class="ship__text">
      {%- if remaining > 0 -%}
        {%- assign amount = remaining | money_without_currency | append: ' €' -%}
        {{ 'cart.free_shipping_left' | t | replace: '[amount]', amount }}
      {%- else -%}
        {% render 'icon', name: 'check', class: 'icon--sm' %}{{ 'cart.free_shipping_reached' | t }}
      {%- endif -%}
    </p>
    <div class="ship__bar" aria-hidden="true"><span style="transform: scaleX({{ pct | divided_by: 100.0 }})"></span></div>
  </div>
{%- endif -%}
