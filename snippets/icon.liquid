    {%- when 'clock' -%}<circle cx="12" cy="12" r="8.5"/><path d="M12 7v5l3 2"/>
    {%- when 'phone' -%}<path d="M5 3h4l2 5-2.5 1.5a11 11 0 006 6L16 13l5 2v4a2 2 0 01-2 2A17 17 0 013 5a2 2 0 012-2z"/>
    {%- when 'mail' -%}<path d="M3 5h18v14H3z"/><path d="M3 6l9 7 9-7"/>
    {%- when 'instagram' -%}<rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="0.6" fill="currentColor"/>
