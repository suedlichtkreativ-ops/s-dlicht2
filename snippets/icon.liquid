    {%- when 'tiktok' -%}<path d="M14 3v11.5a3.5 3.5 0 11-3.5-3.5M14 3c.5 2.7 2.3 4.4 5 4.6"/>
    {%- else -%}<circle cx="12" cy="12" r="2"/>
  {%- endcase -%}
