    {%- when 'chevron-down' -%}<path d="M6 9l6 6 6-6"/>
    {%- when 'chevron-right' -%}<path d="M9 6l6 6-6 6"/>
    {%- when 'chevron-left' -%}<path d="M15 6l-6 6 6 6"/>
    {%- when 'arrow' -%}<path d="M4 12h15M13 6l6 6-6 6"/>
    {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}<path d="M5 12h14"/>
    {%- when 'filter' -%}<path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0"/><circle cx="16" cy="6" r="2"/><circle cx="10" cy="12" r="2"/><circle cx="18" cy="18" r="2"/>
    {%- when 'store' -%}<path d="M4 10v10h16V10M3 4h18l-1.5 6h-15zM9 20v-6h6v6"/>
    {%- when 'truck' -%}<path d="M2 6h12v10H2zM14 10h4l3 3v3h-7"/><circle cx="6" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/>
