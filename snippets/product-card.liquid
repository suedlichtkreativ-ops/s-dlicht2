{%- comment -%}
  Params: product (may be blank -> placeholder), index (for placeholders), sizes, show_vendor
{%- endcomment -%}
{%- liquid
  assign sizes = sizes | default: '(min-width: 1200px) 22vw, (min-width: 750px) 30vw, 46vw'
-%}
<div class="card">
  <div class="card__media">
    {%- if product != blank -%}
      <div class="card__badges">
        {%- if product.available == false -%}
          <span class="badge badge--light">{{ 'products.product.sold_out' | t }}</span>
        {%- elsif product.compare_at_price > product.price -%}
          <span class="badge">{{ 'products.product.on_sale' | t }}</span>
        {%- endif -%}
      </div>
      {%- if product.available -%}
        {%- if product.has_only_default_variant -%}
          <form class="card__quick" method="post" action="{{ routes.cart_add_url }}" data-product-form>
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button type="submit" class="card__add" aria-label="{{ 'products.product.add_to_cart' | t }}: {{ product.title | escape }}">
              <span class="btn__label">{% render 'icon', name: 'cart-plus' %}</span>
              <span class="spinner" aria-hidden="true"></span>
            </button>
          </form>
        {%- else -%}
          {%- comment -%} Several variants: pick colour/size in the quick-add drawer first. {%- endcomment -%}
          <div class="card__quick">
            <button type="button" class="card__add" data-quick-add="{{ product.url }}" aria-haspopup="dialog" aria-controls="QuickAdd" aria-expanded="false" aria-label="{{ 'products.product.choose_options_for' | t: title: product.title | escape }}">
              <span class="btn__label">{% render 'icon', name: 'cart-plus' %}</span>
              <span class="spinner" aria-hidden="true"></span>
            </button>
          </div>
        {%- endif -%}
      {%- endif -%}
      <div class="media">
        {%- if product.featured_media -%}
          {% render 'image', image: product.featured_media.preview_image, sizes: sizes, class: 'card__img-main', alt: product.title %}
          {%- if product.media[1] -%}
            {% render 'image', image: product.media[1].preview_image, sizes: sizes, class: 'card__img-alt', alt: '' %}
          {%- endif -%}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    {%- else -%}
      <div class="media">
        {%- assign ph = index | modulo: 6 | plus: 1 -%}
        {{ 'product-' | append: ph | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {%- endif -%}
  </div>

  {%- liquid
    assign card_title = product.title
    if settings.card_strip_vendor and settings.card_title_prefix != blank
      assign vendor_prefix = settings.card_title_prefix | strip | append: ' '
      assign title_start = product.title | slice: 0, vendor_prefix.size
      if title_start == vendor_prefix
        assign card_title = product.title | remove_first: vendor_prefix
      endif
    endif
    assign color_count = 0
    for option in product.options_with_values
      assign on = option.name | downcase
      if on contains 'farbe' or on contains 'color'
        assign color_count = option.values.size
      endif
    endfor
  -%}
  <div class="stack" style="--stack:.3rem">
    {%- if show_vendor and product.vendor != blank -%}
      <p class="card__vendor">{{ product.vendor }}</p>
    {%- endif -%}
    <h3 class="card__title">
      {%- if product != blank -%}
        <a class="card__link" href="{{ product.url }}">{{ card_title | escape }}</a>
      {%- else -%}
        {{ 'products.product.placeholder_title' | t }}
      {%- endif -%}
    </h3>
    {%- if product != blank and settings.card_show_meta -%}
      {%- if product.type != blank or color_count > 1 -%}
        {%- capture card_weight -%}{% render 'product-weight', product: product, kind: 'weight' %}{%- endcapture -%}
        {%- capture card_cast -%}{% render 'product-weight', product: product, kind: 'cast' %}{%- endcapture -%}
        <p class="card__meta">
          {%- assign meta_parts = '' -%}
          {%- if product.type != blank -%}{%- assign meta_parts = meta_parts | append: product.type | append: '§' -%}{%- endif -%}
          {%- if card_cast != blank -%}{%- assign cast_label = 'products.product.cast_short' | t: weight: card_cast -%}{%- assign meta_parts = meta_parts | append: cast_label | append: '§' -%}
          {%- elsif card_weight != blank -%}{%- assign meta_parts = meta_parts | append: card_weight | append: '§' -%}{%- endif -%}
          {%- if color_count > 1 -%}{%- assign colors_label = 'products.product.colors' | t: count: color_count -%}{%- assign meta_parts = meta_parts | append: colors_label | append: '§' -%}{%- endif -%}
          {{- meta_parts | split: '§' | join: ' · ' | escape -}}
        </p>
      {%- endif -%}
    {%- endif -%}
    {%- if product != blank -%}
      <div class="card__foot">
        {% render 'price', product: product, target: product.selected_or_first_available_variant, use_from: true %}
        {%- comment -%} Target-fish marks only on lures: for rods and reels the power class decides, not the fish. {%- endcomment -%}
        {%- if settings.card_show_meta and product.tags contains 'kategorie-koeder' -%}
          {%- capture card_fish -%}
            {%- for tag in product.tags -%}
              {%- if tag contains 'zielfisch-' -%}
                {%- assign fish_label = tag | remove: 'zielfisch-' | capitalize -%}
                <li class="card__fish-item" title="{{ fish_label }}">{% render 'fish-icon', name: tag %}<span class="visually-hidden">{{ fish_label }}</span></li>
              {%- endif -%}
            {%- endfor -%}
          {%- endcapture -%}
          {%- if card_fish != blank -%}<ul class="card__fish" role="list" aria-label="{{ 'products.product.specs_fish' | t }}">{{ card_fish }}</ul>{%- endif -%}
        {%- endif -%}
      </div>
    {%- else -%}
      <div class="price">{{ 1999 | money_without_currency | append: ' €' }}</div>
    {%- endif -%}
  </div>


</div>
