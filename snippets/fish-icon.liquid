{%- comment -%}
  Target fish: the shop's own drawings for Hecht, Zander, Barsch, Forelle; line-art SVG fallback for Karpfen.
  Line-art target fish. Param: name – any title or handle containing hecht, zander, barsch, forelle or karpfen
  (e.g. "Hechtköder"), class.
  Renders nothing for unknown names so callers can pass any handle.
  Stroke uses currentColor; spots/eyes fill with currentColor.
{%- endcomment -%}
{%- liquid
  assign raw = name | handleize
  assign fish_name = ''
  if raw contains 'hecht'
    assign fish_name = 'hecht'
  elsif raw contains 'zander'
    assign fish_name = 'zander'
  elsif raw contains 'barsch'
    assign fish_name = 'barsch'
  elsif raw contains 'forelle'
    assign fish_name = 'forelle'
  elsif raw contains 'karpfen'
    assign fish_name = 'karpfen'
  endif
-%}
{%- if fish_name == 'hecht' or fish_name == 'zander' or fish_name == 'barsch' or fish_name == 'forelle' -%}
  {%- comment -%} Köderdepot's own line drawings (white on transparent), taken from the previous shop. {%- endcomment -%}
  {%- assign drawing = 'fish-' | append: fish_name | append: '.png' -%}
  <img class="fish fish--drawing {{ class }}" src="{{ drawing | asset_url }}" width="224" height="224" alt="" aria-hidden="true" loading="lazy">
{%- elsif fish_name != '' -%}
<svg class="fish {{ class }}" viewBox="0 0 100 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case fish_name -%}
    {%- when 'hecht' -%}
      <path d="M5 24 C13 19 30 17 52 18 C66 19 76 21 82 24 C76 27 66 29 52 30 C30 31 13 29 5 24Z"/>
