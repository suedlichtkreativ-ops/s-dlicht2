{%- comment -%} Shared line items for drawer and cart page. Param: context ('drawer'|'page') {%- endcomment -%}
<ul class="cart-items" role="list">
  {%- for item in cart.items -%}
    <li class="cart-item" data-line="{{ forloop.index }}" data-key="{{ item.key }}" data-variant-id="{{ item.variant_id }}" data-quantity="{{ item.quantity }}" data-title="{{ item.product.title | escape }}">
      <a href="{{ item.url }}" class="media" tabindex="-1" aria-hidden="true">
        {%- if item.image -%}
          {% render 'image', image: item.image, sizes: '96px', widths: '96, 192, 288', alt: '' %}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </a>
      <div class="cart-item__info">
        <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>
        {%- unless item.product.has_only_default_variant -%}
          <p class="cart-item__meta">{{ item.variant.title | escape }}</p>
        {%- endunless -%}
        {%- for property in item.properties -%}
          {%- unless property.first contains '_' or property.last == blank -%}
            <p class="cart-item__meta">{{ property.first }}: {{ property.last }}</p>
          {%- endunless -%}
        {%- endfor -%}
        {%- if item.selling_plan_allocation -%}
          <p class="cart-item__meta">{{ item.selling_plan_allocation.selling_plan.name }}</p>
        {%- endif -%}
        {%- for discount in item.line_level_discount_allocations -%}
          <p class="cart-item__meta">{{ discount.discount_application.title }} (−{{ discount.amount | money }})</p>
        {%- endfor -%}
        <div class="cart-item__row">
          <div class="qty qty--sm" data-qty>
            <button type="button" data-qty-change="-1" aria-label="{{ 'cart.decrease' | t: title: item.product.title | escape }}">{% render 'icon', name: 'minus', class: 'icon--sm' %}</button>
            <input type="number" inputmode="numeric" min="0" value="{{ item.quantity }}" data-line-qty="{{ forloop.index }}" aria-label="{{ 'cart.quantity_for' | t: title: item.product.title | escape }}">
            <button type="button" data-qty-change="1" aria-label="{{ 'cart.increase' | t: title: item.product.title | escape }}">{% render 'icon', name: 'plus', class: 'icon--sm' %}</button>
          </div>
          <div class="price">
            {%- if item.original_line_price != item.final_line_price -%}
              <span class="price__current" style="color:var(--alert)">{{ item.final_line_price | money }}</span>
              <s>{{ item.original_line_price | money }}</s>
            {%- else -%}
              {{ item.final_line_price | money }}
            {%- endif -%}
          </div>
        </div>
        <button type="button" class="cart-item__remove" data-remove-line="{{ forloop.index }}">{{ 'cart.remove' | t }}<span class="visually-hidden">: {{ item.product.title | escape }}</span></button>
      </div>
    </li>
  {%- endfor -%}
</ul>
